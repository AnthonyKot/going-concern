rimaryMenu","type":"component","componentClass":"org.onehippo.cms7.essentials.components.EssentialsMenuComponent","models":{"menu":{"$ref":"#uf3c2e7ddfdb14aed8f5a2d71969d7a58"}}},"ua3dec0754de44ed18b5d8c890792e05c":{"id":"r15_r2_r2","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/?_hn:type=component-rendering\u0026_hn:ref=r15_r2_r2\u0026refPrefix=%23","type":"external"}},"meta":{"paramsInfo":{"siteMenu":"headerSecondaryMenu"},"params":{"selectedMenu":"on","level":"1"}},"name":"secondaryMenu","type":"component","componentClass":"org.onehippo.cms7.essentials.components.EssentialsMenuComponent","models":{"menu":{"$ref":"#u84c4c97b16e849dba22e6316924b3233"}}},"u0102972aa1844f3a98cdb620e78a0490":{"id":"r15_r3_r1","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/?_hn:type=component-rendering\u0026_hn:ref=r15_r3_r1\u0026refPrefix=%23","type":"external"}},"meta":{"paramsInfo":{"siteMenu":"footerPrimaryMenu"},"params":{"selectedMenu":"on","level":"1"}},"name":"primaryMenu","type":"component","componentClass":"org.onehippo.cms7.essentials.components.EssentialsMenuComponent","models":{"menu":{"$ref":"#ub7e28775f23c4c12af24811f341d3967"}}},"uf6b6912aa17741f8ab8b307d774347a9":{"id":"r15_r3_r2","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/?_hn:type=component-rendering\u0026_hn:ref=r15_r3_r2\u0026refPrefix=%23","type":"external"}},"meta":{"hidden":false,"paramsInfo":{"document":"#ud6a37747a4494f9aa496c82e4b34af98"},"params":{}},"name":"leftFooterText","type":"component","componentClass":"org.onehippo.cms7.essentials.components.EssentialsDocumentComponent","models":{"document":{"$ref":"#ud6a37747a4494f9aa496c82e4b34af98"}}},"udf16a07f350949fcaf110233ab391e4d":{"id":"r15_r3_r3","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/?_hn:type=component-rendering\u0026_hn:ref=r15_r3_r3\u0026refPrefix=%23","type":"external"}},"meta":{"hidden":false,"paramsInfo":{"document":"#ufbb0cfa366d4418496b6d1c63c35d9a4"},"params":{}},"name":"rightFooterText","type":"component","componentClass":"org.onehippo.cms7.essentials.components.EssentialsDocumentComponent","models":{"document":{"$ref":"#ufbb0cfa366d4418496b6d1c63c35d9a4"}}},"u8ef5c5859d5d4c9b8c503bf3a6efce38":{"id":"r15_r3_r4","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/?_hn:type=component-rendering\u0026_hn:ref=r15_r3_r4\u0026refPrefix=%23","type":"external"}},"meta":{"paramsInfo":{"siteMenu":"footerSecondaryMenu"},"params":{"selectedMenu":"on","level":"1"}},"name":"secondaryMenu","type":"component","componentClass":"org.onehippo.cms7.essentials.components.EssentialsMenuComponent","models":{"menu":{"$ref":"#u5812f060518246f784281313db4a092d"}}},"u51c8e38a652a43c289b7873c7c5438da":{"id":"r15_r3_r5","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/?_hn:type=component-rendering\u0026_hn:ref=r15_r3_r5\u0026refPrefix=%23","type":"external"}},"meta":{"params":{}},"name":"socialMenu","type":"component","componentClass":"org.hippoecm.hst.core.component.GenericHstComponent"},"u9ae4ddd2a07e42c2a304d52468bafba8":{"id":"r15_r3_r6","links":{"self":{"href":"https://production-site-nl.kvk.bloomreach.cloud/resourceapi/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/?_hn:type=component-rendering\u0026_hn:ref=r15_r3_r6\u0026refPrefix=%23","type":"external"}},"meta":{"hidden":false,"paramsInfo":{"document":"#u86c6c3f899824973bd04c1370bb7c640"},"params":{}},"name":"footerImage","type":"component","componentClass":"org.onehippo.cms7.essentials.components.EssentialsDocumentComponent","models":{"document":{"$ref":"#u86c6c3f899824973bd04c1370bb7c640"}}},"u8634db911fe9448499819c981f5c34a1":{"type":"document","links":{"site":{"href":"/stoppen-en-uitschrijven/stoppen-met-ondernemen-dit-moet-je-regelen/","type":"internal"}},"meta":{},"data":{"name":"stoppen-met-ondernemen-dit-moet-je-regelen","displayName":"Stoppen met ondernemen? Dit moet je regelen","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Stoppen met ondernemen? Dit moet je regelen","seodescription":"Voordat je stopt met je bedrijf en je uitschrijft bij KVK, zijn er een aantal belangrijke stappen die je moet nemen.","seonoindex":true,"contentType":"seosupport:seo"},"contentBlocks":[],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"Bij het stoppen van je bedrijf komt meer kijken dan alleen uitschrijven bij KVK. Voordat je stopt met je bedrijf en je uitschrijft bij KVK, zijn er een aantal belangrijke stappen. In deze video bespreken we een checklist die je helpt om alle stappen te doorlopen.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Voordat je stopt met je bedrijf en je uitschrijft bij KVK, zijn er een aantal belangrijke stappen die je moet nemen.","title":"Stoppen met ondernemen? Dit moet je regelen","image":{"$ref":"#ua1d590db55734065862660ad34d01c9f"},"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"youTube":{"name":"kvkwebsite:youTube","displayName":"kvkwebsite:youTube","duration":{"name":"kvkwebsite:duration","displayName":"kvkwebsite:duration","seconds":0,"minutes":0,"contentType":"kvkwebsite:duration"},"labels":{"videoRegardingSubject":"Video met het onderwerp","cookieLinkText":"Lees meer over onze cookieverklaring","cookieLinkTextSmall":"Onze cookieverklaring","acceptButtonText":"Alle cookies accepteren","introductionText":"Door jouw cookie-instellingen kun je deze video helaas niet bekijken. Wil je de video toch bekijken?","youtubeButtonText":"Bekijk op YouTube","videoWithoutTitle":"Video zonder titel","middleText":"of"},"videoId":"HgK_Ao1khlg","contentType":"kvkwebsite:youTube"},"relatedDocuments":[{"uuid":"32921fdf-781d-43f1-b500-eaaa06bbd28c"}],"videoSerie":[],"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":1,"editorialPublicationDateWithDefault":1772705575958,"editorialModificationDate":1772705520000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1772705520000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Stoppen en uitschrijven","key":"6","contentType":"selection:listitem","id":"a45fcc76-fd4e-4d34-8120-2d98cdcccad2"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Geldzaken","key":"2","contentType":"selection:listitem","id":"72926466-9b4d-4d40-9eb4-bd80dcae2295"}],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Belastingen","key":"7","contentType":"selection:listitem","id":"f5024357-07cf-4c0c-a8da-f3c8afdfa9c7"}],"sector":[],"audience":[{"name":"selection:listitem","displayName":"selection:listitem","label":"ZZP","key":"1","contentType":"selection:listitem","id":"b03acec6-5662-43ab-a10d-e2e22c7f0da5"},{"name":"selection:listitem","displayName":"selection:listitem","label":"Micro-MKB","key":"2","contentType":"selection:listitem","id":"92f7f673-f3fd-4021-b827-bb7cb926679d"},{"name":"selection:listitem","displayName":"selection:listitem","label":"MKB","key":"3","contentType":"selection:listitem","id":"296c1685-798e-4ab5-9cf7-893d38cf092e"}],"articleType":null,"author":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Marie-José te Riet-Kerkhof","key":"marie-jose-te-riet-kerkhof","contentType":"selection:listitem","id":"9c752a5a-99a8-43e2-9e6a-77cb7ea9a139"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Stoppen","key":"stoppen","contentType":"selection:listitem","id":"7fec2ef5-1a24-4817-8070-e64658c0680a"}],"lawOpenGovernment":[null]},"title":"Stoppen met ondernemen? Dit moet je regelen","localeString":"nl","contentType":"kvkwebsite:videoDocument","systemCreationDate":1726067130906,"systemModificationDate":1772705571680,"systemPublicationDate":1772705575958,"id":"8634db91-1fe9-4484-9981-9c981f5c34a1"}},"u3bdefbfdefc04c939ac894bbdcc744fd":{"type":"document","links":{"site":{"href":"/stoppen-en-uitschrijven/fiscale-oudedagsreserve-for-bij-stoppen/","type":"internal"}},"meta":{},"data":{"name":"fiscale-oudedagsreserve-for-bij-stoppen","displayName":"Fiscale oudedagsreserve (FOR) bij stoppen","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Fiscale oudedagsreserve (FOR) bij stoppen bedrijf","seodescription":"Stoppen met je bedrijf? Heb je fiscale oudedagsreserve (FOR) opgebouwd, dan komt deze vrij. Weet wat je kunt doen met je FOR als je stopt met ondernemen","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003cp\u003eDe FOR\u0026#160;was een\u0026#160;regeling\u0026#160;voor ondernemers in de inkomstenbelasting. Je kon elk jaar een deel van je winst reserveren voor je oude dag. Je betaalde daar op dat moment geen belasting over. De FOR bestond dus vooral op papier: je hoefde het geld niet echt apart te zetten.\u0026#160;Maar je moet er wel wat mee,\u0026#160;wanneer\u0026#160;je stopt met ondernemen.\u0026#160;Met een goed plan voorkom je dat je onverwacht veel belasting betaalt.\u0026#160;\u003c/p\u003e\n\n\u003ch2\u003eMaak een plan v\u0026#243;\u0026#243;r je stopt\u0026#160;\u003c/h2\u003e\n\n\u003cp\u003eWelke\u0026#160;optie\u0026#160;het beste bij je past, hangt altijd af van jouw situatie.\u0026#160;Kijk naar je totale plaatje.\u0026#160;Denk aan je leeftijd, je inkomen nu en straks, je \u003cabbr tooltip=\"Of je direct geld beschikbaar hebt\" title=\"Of je direct geld beschikbaar hebt\"\u003eliquiditeit\u003c/abbr\u003e en of je het geld direct nodig hebt. De\u0026#160;FOR\u0026#160;kan financieel gunstig uitpakken, maar alleen als je de juiste stappen zet. Bespreek je plannen daarom met een boekhouder, financieel adviseur of pensioenexpert. Regel dit v\u0026#243;\u0026#243;r je uitschrijving,\u0026#160;zo voorkom je verrassingen achteraf.\u0026#160;\u003c/p\u003e\n\n\u003ch2\u003eWelke opties heb je?\u0026#160;\u003c/h2\u003e\n\n\u003ch3\u003e1. FOR omzetten in een lijfrente\u0026#160;\u003c/h3\u003e\n\n\u003cp\u003eMet een lijfrente zet je geld apart voor later. Je kunt kiezen tussen een opbouwende lijfrente en een uitkerende\u0026#160;lijfrente.\u0026#160;Dit kun je doen bij een\u0026#160;bank, verzekeraar of beleggingsinstelling.\u0026#160;\u003c/p\u003e\n\n\u003ch4\u003eOpbouwende lijfrente\u0026#160;\u003c/h4\u003e\n\n\u003cp\u003eBij een opbouwende lijfrente stort je je FOR in een product dat nog niet uitkeert. Het geld staat vast tot je een bepaalde leeftijd bereikt. Je betaalt nu geen belasting over de FOR. De belasting verschuift naar later, wanneer je de uitkeringen ontvangt.\u0026#160;Dit past vaak goed als je nog niet met pensioen bent en het geld voorlopig niet nodig hebt. Je bouwt hiermee een deel van je pensioen op en spreidt je belasting over meerdere jaren.\u0026#160;\u003c/p\u003e\n\n\u003ch4\u003eUitkerende lijfrente\u0026#160;\u003c/h4\u003e\n\n\u003cp\u003eBij een uitkerende lijfrente zet je het bedrag om in een product dat direct of binnen korte tijd uitkeert. Je ontvangt periodieke bedragen, bijvoorbeeld maandelijks of per kwartaal.\u0026#160;Je betaalt belasting over deze uitkeringen. Als je met pensioen bent, is je inkomen meestal lager en betaal je minder belasting over de uitkering. Deze optie is vaak geschikt als je (bijna) de\u0026#160;AOW‑leeftijd\u0026#160;hebt als je stopt.\u0026#160;\u003c/p\u003e\n\n\u003ch4\u003eBeschikbaar geld\u0026#160;\u003c/h4\u003e\n\n\u003cp\u003eVoor beide opties heb je liquiditeit nodig. Liquiditeit betekent dat je genoeg direct beschikbaar geld hebt om de storting te doen. Denk aan saldo op je bankrekening of spaargeld dat je meteen kunt opnemen. Heb je je FOR ge\u0026#239;nvesteerd in voorraad, machines of andere bedrijfsmiddelen? Dan heb je vermogen, maar geen liquiditeit. In dat geval kun je geen lijfrente storten.\u0026#160;\u0026#160;\u003c/p\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","icon":"BellIcon","text":{"contentType":"hippostd:html","value":"\u003cp\u003eJe kunt je FOR alleen omzetten in een lijfrente tot 31 december van het jaar waarin je stopt met ondernemen.\u0026#160;Daarna\u0026#160;kun je geen lijfrente meer gebruiken om belasting te voorkomen of uit te stellen.\u003c/p\u003e"},"title":"Lijfrente storten kan alleen in hetzelfde jaar ","contentType":"kvkwebsite:attentionAlert"},{"contentType":"hippostd:html","value":"\u003ch3\u003e2. Direct afrekenen met de Belastingdienst\u0026#160;\u003c/h3\u003e\n\n\u003cp\u003eJe kunt ook niets doen. Dan reken je automatisch af\u0026#160;met de Belastingdienst. De FOR telt volledig mee als winst. Dit kan je in een hogere belastingschijf brengen. Deze optie is eenvoudig, maar financieel vaak minder gunstig. Toch kan direct afrekenen passen als je geen liquiditeit hebt of als je de FOR bewust wilt afronden zonder verdere verplichtingen.\u0026#160;\u003c/p\u003e\n\n\u003ch3\u003e3. Gebruikmaken van de stakingsaftrek\u0026#160;\u003c/h3\u003e\n\n\u003cp\u003eStop je met ondernemen, dan kun je mogelijk\u0026#160;stakingsaftrek\u0026#160;toepassen. Deze\u0026#160;aftrek\u0026#160;verlaagt je winst en daarmee de belasting over je FOR. De aftrek geldt \u0026#233;\u0026#233;n keer en heeft een maximum. De stakingsaftrek verlaagt je belasting, maar neemt deze niet volledig weg. Het is vooral een manier om de\u0026#160;belastingdruk te verzachten, niet om deze te voorkomen.\u0026#160;\u003c/p\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","icon":"IdeaIcon","text":{"contentType":"hippostd:html","value":"\u003cp\u003eVerkoop je je bedrijf? Dan kun je soms een lijfrente afspreken met de koper.\u0026#160;Je zet de FOR om in een lijfrente zonder dat je zelf geld hoeft te storten.\u0026#160;De koper betaalt jou dan later in termijnen.\u0026#160;Dit werkt alleen als de koper hiermee instemt, maar het kan een oplossing zijn als je geen liquiditeit hebt en toch belasting wilt uitstellen.\u0026#160;\u003c/p\u003e"},"title":"Lijfrente afspreken bij verkoop van je bedrijf ","contentType":"kvkwebsite:attentionAlert"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"Stop je met je bedrijf? Heb je fiscale oudedagsreserve (FOR) opgebouwd, dan komt deze vrij. De FOR is jarenlang een manier geweest om geld opzij te zetten voor later. Sinds 2023 kun je geen nieuwe FOR meer opbouwen, maar veel ondernemers hebben nog wel een bestaande reserve. Nu je stopt, telt de Belastingdienst dit bedrag op bij je winst. Je betaalt daar inkomstenbelasting over. Dat kan flink oplopen. Bepaal daarom vóór je uitschrijving wat je met je FOR doet.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Weet wat je kunt doen met je Fiscale oudedagsreserve als je stopt met ondernemen","title":"Fiscale oudedagsreserve bij stoppen bedrijf","image":null,"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"featuredCards":{"name":"kvkwebsite:featuredCards","displayName":"kvkwebsite:featuredCards","featuredCards":[{"uuid":"65c6019a-06ac-4b91-a930-0f99ba4f8160"},{"uuid":"0d10f8b5-6ff1-44a5-9204-742ce95eadff"},{"uuid":"316256ae-781a-4b1c-8d83-4ccf6267c95c"}],"cards":[{"uuid":"65c6019a-06ac-4b91-a930-0f99ba4f8160"},{"uuid":"0d10f8b5-6ff1-44a5-9204-742ce95eadff"},{"uuid":"316256ae-781a-4b1c-8d83-4ccf6267c95c"}],"title":"Anderen lezen ook","contentType":"kvkwebsite:featuredCards"},"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":2,"editorialPublicationDateWithDefault":1777014360000,"editorialModificationDate":null,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":1777014360000,"mostRecentChangeDate":1777014360000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Stoppen en uitschrijven","key":"6","contentType":"selection:listitem","id":"a45fcc76-fd4e-4d34-8120-2d98cdcccad2"}],"theme":[],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Voordat je start","key":"64","contentType":"selection:listitem","id":"01440e24-4a75-4f42-92b1-514838d74357"}],"sector":[],"audience":[],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","label":"Achtergrond","key":"1","contentType":"selection:listitem","id":"59d14c68-fbb8-4a64-9be0-7633b09fc7f5"},"author":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Hajar Scholten","key":"hajar-scholten","contentType":"selection:listitem","id":"b6183787-4d09-430c-9a3f-57a8da034ca9"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Stoppen","key":"stoppen","contentType":"selection:listitem","id":"7fec2ef5-1a24-4817-8070-e64658c0680a"}],"lawOpenGovernment":[null]},"title":"Fiscale oudedagsreserve (FOR) bij stoppen","image":{"$ref":"#u1e6df6c51e87483ab70558e7825c07ba"},"localeString":"nl","contentType":"kvkwebsite:inspirationDocument","systemCreationDate":1779442497308,"systemModificationDate":1785154443286,"systemPublicationDate":1785154448830,"id":"3bdefbfd-efc0-4c93-9ac8-94bbdcc744fd"}},"u9e36dcd83b314a5ea1d62aab987da198":{"type":"document","links":{"site":{"href":"/wetten-en-regels/personenvennoot-schap-in-nieuwe-jas/","type":"internal"}},"meta":{},"data":{"name":"personenvennoot-schap-in-nieuwe-jas","displayName":"Regels voor vof, cv en maatschap veranderen","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Regels voor vof, cv en maatschap veranderen","seodescription":"De regels voor de personenvennootschappen vof, cv en maatschap wijzigen. Samen een bedrijf starten moet daardoor makkelijker zijn.","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003cp\u003eDe huidige regels voor de maatschap, commanditaire vennootschap (cv) en vennootschap onder firma (vof) komen voor een deel uit 1838. De overheid wil die met de \u003ca rel=\"noopener noreferrer\" href=\"https://wetgevingskalender.overheid.nl/Regeling/WGK007901\" class=\"external-link\" target=\"_blank\"\u003eWet Modernisering Personenvennootschappen\u003c/a\u003e\u0026#160;aanpassen.\u0026#160;\u003c/p\u003e\n\n\u003cp\u003eDe wet is nog \u003ca href=\"https://wetgevingskalender.overheid.nl/Regeling/WGK007901\" class=\"external-link\"\u003ein voorbereiding\u003c/a\u003e. De datum waarop de wet ingaat, is niet bekend. Actie ondernemen is daarom nu niet nodig voor een cv, vof of maatschap (personenvennootschap).\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eVof en maatschap verdwijnen\u003c/h2\u003e\n\n\u003cp\u003eDe vof en maatschap \u003ca rel=\"noopener noreferrer\" href=\"http://ondernemersplein.kvk.nl/vereenvoudiging-verschil-maatschap-en-vof-gaat-verdwijnen/\" class=\"external-link\" target=\"_blank\"\u003everdwijnen\u003c/a\u003e volgens het wetsvoorstel. Daarvoor in de plaats komt een openbare vennootschap (ov). De cv blijft bestaan.\u003c/p\u003e\n\n\u003cp\u003eDaarnaast krijgen personenvennootschappen onder meer rechtspersoonlijkheid, verandert de aansprakelijkheid en de regels voor het voortzetten.\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eRechtspersoonlijkheid\u003c/h2\u003e\n\n\u003cp\u003eDe ov en cv krijgen rechtspersoonlijkheid volgens het voorstel. Een ov en cv kunnen daardoor zelfstandig optreden en makkelijk van rechtsvorm wisselen. Ook kun je daardoor goederen op naam van een vennootschap zetten, zoals een bedrijfspand.\u003c/p\u003e\n\n\u003cp\u003eNu hebben personenvennootschappen geen rechtspersoonlijkheid. Daardoor moeten vennoten of maten in persoon optreden en is wisselen van rechtsvorm lastig. Ook kan een \u003ca class=\"anchor-target\" href=\"/starten/de-vennootschap-onder-firma-vof/\" data-type=\"internal\"\u003evof\u003c/a\u003e, \u003ca class=\"anchor-target\" href=\"/starten/de-commanditaire-vennootschap-cv/\" data-type=\"internal\"\u003ecv\u003c/a\u003e of \u003ca class=\"anchor-target\" href=\"/starten/de-maatschap/\" data-type=\"internal\"\u003emaatschap\u003c/a\u003e geen goederen op naam hebben. Die bezittingen staan op naam van vennoten of maten.\u003c/p\u003e\n\n\u003cp\u003eDat de ov en cv rechtspersoonlijkheid krijgen, geeft duidelijkheid aan schuldeisers. Zij kunnen dan makkelijk in registers zien welke bezittingen de vennootschap heeft, bijvoorbeeld bij het Kadaster. Zo komt er een scheiding tussen priv\u0026#233; en -bedrijfsvermogen.\u003c/p\u003e\n\n\u003cp\u003eHet is ook lastig nu een personenvennootschap om te zetten in een rechtspersoon zoals een bv, nv, co\u0026#246;peratie, vereniging of stichting. Doordat een ov en cv rechtspersoonlijkheid krijgen, kan dat na de invoering van de wet veel makkelijker.\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eAansprakelijkheid\u003c/h2\u003e\n\n\u003cp\u003eDe regels voor aansprakelijkheid veranderen ook. Doordat de ov en cv rechtspersoonlijkheid krijgen, kunnen schuldeisers de vennootschap direct aanspreken. Kan die de vordering niet voldoen? Dan zijn de vennoten van de ov of cv hoofdelijk aansprakelijk. Dat betekent dat elke vennoot voor het hele bedrag is aan te spreken.\u003c/p\u003e\n\n\u003cp\u003eDat is nu ook al zo bij een vof en cv. Bij een maatschap zijn de maten nu voor gelijke delen aansprakelijk. Bijvoorbeeld voor een kwart van het bedrag als er vier maten zijn.\u0026#160;\u003c/p\u003e\n\n\u003ch3\u003eBeperken tot vennoot\u003c/h3\u003e\n\n\u003cp\u003eDe nieuwe wet moet het mogelijk maken \u0026#233;\u0026#233;n vennoot aansprakelijk te stellen bij een opdracht. Alleen die vennoot moet dan de opdracht hebben gekregen. Denk dan bijvoorbeeld aan de restauratie van een kunstwerk of het geven van fiscaal advies.\u003c/p\u003e\n\n\u003cp\u003eAls de opdracht fout gaat, zijn de andere vennoten niet aansprakelijk. Daardoor is het makkelijker werk aan te nemen waar meer risico aan zit.\u003c/p\u003e\n\n\u003ch3\u003eNa in- of uittreden\u003c/h3\u003e\n\n\u003cp\u003eDe aansprakelijkheid van vennoten na intreden en uittreden verandert ook. Je kan straks tot 5 jaar na je uittreden aansprakelijk worden gesteld. Daarna niet meer. Nu kan dat over een langere periode. Bijvoorbeeld als een contract een langere looptijd heeft.\u003c/p\u003e\n\n\u003cp\u003eEen toetredende vennoot wordt straks beter beschermd tegen vorderingen op de personenvennootschap die zijn ontstaan voor zijn toetreden. Daarvoor is de vennoot niet aansprakelijk, tenzij die vordering opeisbaar is geworden na zijn toetreden.\u0026#160;\u003c/p\u003e\n\n\u003cp\u003eNu ben je na je toetreden meteen aansprakelijk voor opeisbare vorderingen, zoals schulden voor de huur- of energierekening van de vennootschap. De wijziging geeft schuldeisers en vennoten meer zekerheid.\u003c/p\u003e\n\n\u003ch3\u003eMedeaansprakelijk bij cv\u003c/h3\u003e\n\n\u003cp\u003eEen geldschieter mag voortaan ook in het openbaar handelingen voor de cv doen zonder medeaansprakelijk te zijn. Dat kan op basis van een volmacht. De geldschieter is nu wel medeaansprakelijk als die in het openbaar handelingen doet voor de cv.\u0026#160;\u003c/p\u003e\n\n\u003cp\u003eHet handelen van de gevolmachtigde geldschieter mag niet een belangrijke oorzaak zijn van een faillissement. Dan is die wel medeaansprakelijk. Door die regels is de cv flexibeler, zonder daarmee schuldeisers te benadelen.\u0026#160;\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eInschrijven Handelsregister\u003c/h2\u003e\n\n\u003cp\u003eIs de ov of cv niet ingeschreven in het Handelsregister? Dan heeft de vennootschap wel rechtspersoonlijkheid. Maar de rechtsbevoegdheid is beperkt.\u003c/p\u003e\n\n\u003cp\u003eZo kan de ov of cv die niet is ingeschreven geen \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.kvk.nl/registergoederen-registreren-bij-het-kadaster/\" class=\"external-link\" target=\"_blank\"\u003eregistergoederen\u003c/a\u003e als een bedrijfspand bezitten, bestuurder zijn in een andere vennootschap, erfgenaam zijn of aandelen op naam hebben. Een vof, cv of maatschap kan nu ook niet.\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eOnderscheid vrije beroeps- en bedrijfsactiviteiten verdwijnt\u003c/h2\u003e\n\n\u003cp\u003eHet onderscheid tussen een \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.kvk.nl/bedrijf-starten/starten-als-zzper/wanneer-heeft-u-een-vrij-beroep/\" class=\"external-link\" target=\"_blank\"\u003evrije beroepsactiviteiten en bedrijfsactiviteiten\u003c/a\u003e verdwijnt. Als de wet ingaat, kun je in een ov of cv een vrije beroeps- en bedrijfsactiviteiten uitvoeren.\u003c/p\u003e\n\n\u003cp\u003eNu verricht je bedrijfsactiviteiten in een vof en maak je voor vrije beroepen gebruik van een maatschap. Vrije beroepen zijn werkzaamheden die iedereen met de juiste kennis en opleiding zelfstandig kan doen. Denk bijvoorbeeld aan een advocaat, notaris of huisarts. Of iemand met een uniek talent of bijzondere kwaliteit, zoals een kunstenaar of artiest.\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eVoortzetten vennootschap bij \u0026#233;\u0026#233;n vennoot\u003c/h2\u003e\n\n\u003cp\u003eEen ov of cv is volgens het wetsvoorstel niet meteen ontbonden als nog maar \u0026#233;\u0026#233;n vennoot over is. De overgebleven vennoot krijgt drie maanden de tijd om alleen door te gaan met het bedrijf. Komt er een nieuwe vennoot? Dan is de vennootschap hersteld.\u003c/p\u003e\n\n\u003cp\u003eNu is de maatschap of vennootschap meteen ontbonden als er nog maar \u0026#233;\u0026#233;n maat of vennoot over is. Behalve als dat anders is geregeld in het contract. Dat de samenwerking direct stopt, is niet altijd handig.\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eMinder lasten\u003c/h2\u003e\n\n\u003cp\u003eOndernemers moeten zo min mogelijk last hebben van de nieuwe wet. Zo is het de bedoeling dat de kosten voor het samenwerkingsverband minder zijn. Het deponeren van een jaarrekening hoeft bijvoorbeeld niet meer. Bestaande vof \u0026#8217;s en maatschappen hoeven hun naam ook niet aan te passen.\u0026#160;Dat voorkomt kosten voor het wijzigen van onder meer websites, visitekaartjes en bestikkering van bedrijfsvoertuigen.\u003c/p\u003e\n\n\u003cp\u003eDe ingangsdatum van de wet is nog niet bekend. Eerst moeten de Tweede en Eerste Kamer instemmen. Dan is ook duidelijk wat de gevolgen zijn voor bestaande vof\u0026#8217;s, cv\u0026#8217;s en maatschappen.\u003c/p\u003e"},{"contentType":"hippostd:html","value":"\u003ch2\u003eHulp\u003c/h2\u003e\n\n\u003cp\u003eHeb je vragen over de nieuwe regels en kom je er niet uit? Neem dan \u003ca rel=\"noopener noreferrer\" href=\"https://www.kvk.nl/hulp-en-contact/\" class=\"internal-link\" target=\"_blank\"\u003econtact\u003c/a\u003e op met KVK. Samen \u0026#160;onderzoeken we wat je situatie is en hoe we je verder kunnen helpen.\u003c/p\u003e"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"De regels voor de personenvennootschappen vof, cv en maatschap wijzigen. Samen een bedrijf starten moet daardoor makkelijker zijn. Ook moet er meer duidelijkheid en zekerheid komen voor vennoten en schuldeisers.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"De regels voor de personenvennootschappen vof, cv en maatschap wijzigen. Samen een bedrijf starten moet daardoor makkelijker zijn.","title":"Regels voor vof, cv en maatschap veranderen","image":null,"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"featuredCards":{"name":"kvkwebsite:featuredCards","displayName":"kvkwebsite:featuredCards","featuredCards":[{"uuid":"654d7249-9b5c-4053-9f69-08c88539d93b"},{"uuid":"7a8b9a89-16ef-407b-b8fd-29959cb78eee"},{"uuid":"09da316a-7795-41c1-9885-c039d8490851"}],"cards":[{"uuid":"654d7249-9b5c-4053-9f69-08c88539d93b"},{"uuid":"7a8b9a89-16ef-407b-b8fd-29959cb78eee"},{"uuid":"09da316a-7795-41c1-9885-c039d8490851"}],"title":"Anderen lezen ook","contentType":"kvkwebsite:featuredCards"},"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":3,"editorialPublicationDateWithDefault":1779792411941,"editorialModificationDate":1779781920000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1779781920000,"phase":[],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Wetten en regels","key":"7","contentType":"selection:listitem","id":"b5e427ce-fd44-4907-9c48-19c36a4dd9d8"}],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Rechtsvormen","key":"44","contentType":"selection:listitem","id":"9a540e91-c67b-42f3-9322-a995d623d8ef"}],"sector":[],"audience":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Micro-MKB","key":"2","contentType":"selection:listitem","id":"92f7f673-f3fd-4021-b827-bb7cb926679d"}],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","label":"Achtergrond","key":"1","contentType":"selection:listitem","id":"59d14c68-fbb8-4a64-9be0-7633b09fc7f5"},"author":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Sergej Schuurman","key":"sergej-schuurman","contentType":"selection:listitem","id":"193bb04a-c737-442b-a267-03d9f9077a15"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"WRR","key":"wrr","contentType":"selection:listitem","id":"d7a9554f-5ea2-4134-9a38-7de44340b812"}],"lawOpenGovernment":[null]},"title":"Regels voor vof, cv en maatschap veranderen","image":{"$ref":"#u6b22d0b60c3c4d1496b3f07ea73713c3"},"localeString":"nl","contentType":"kvkwebsite:inspirationDocument","systemCreationDate":1677768604267,"systemModificationDate":1779792406843,"systemPublicationDate":1779792411941,"id":"9e36dcd8-3b31-4a5e-a1d6-2aab987da198"}},"ua7b1faf19fc9447ca79079396f09e105":{"type":"document","links":{"site":{"href":"/stoppen-en-uitschrijven/hoe-vertel-ik-mijn-klanten-dat-ik-stop/","type":"internal"}},"meta":{},"data":{"name":"hoe-vertel-ik-mijn-klanten-dat-ik-stop","displayName":"Hoe vertel ik mijn klanten dat ik stop?","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Hoe vertel ik mijn klanten dat ik stop?","seodescription":"Maak een overzicht van al je klanten, onderscheid wat je moet en wat je mag, bepaal het juiste moment en communiceer.","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003cp\u003eMaak een overzicht van al je klanten. En breng in kaart:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eIn hoeverre een klant afhankelijk van je is.\u003c/li\u003e\n \u003cli\u003eOf je met je klanten een \u003ca rel=\"noopener noreferrer\" href=\"https://www.pianoo.nl/nl/inkoopproces/fase-1-voorbereiden/mogelijke-procedures/raamovereenkomsten\" class=\"external-link\" target=\"_blank\"\u003eraamovereenkomst\u003c/a\u003e hebt.\u003c/li\u003e\n \u003cli\u003eOf je klant schade lijdt doordat jij stopt.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch2\u003eAfspraken\u003c/h2\u003e\n\n\u003cp\u003eJe afhankelijkheidsrelatie en verleden met je klant weeg je mee als je vertelt dat je met je bedrijf stopt, ongeacht wat je samen op papier hebt gezet. Heb je een raamovereenkomst? Of een duurovereenkomst, waarbij partijen zich verbinden om over en weer prestaties te verrichten? Volg dan zoveel mogelijk \u003ca rel=\"noopener noreferrer\" href=\"https://poelmannvandenbroek.nl/een-overeenkomst-opzeggen-wanneer-kan-dat/\" class=\"external-link\" target=\"_blank\"\u003ede afspraken daarin\u003c/a\u003e over het be\u0026#235;indigen van je samenwerking.\u003c/p\u003e\n\n\u003ch2\u003eVerschil relatie\u003c/h2\u003e\n\n\u003cp\u003eHet maakt verschil wat voor zakelijke relatie je met je klant hebt. Een paar voorbeelden:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eAfhankelijkheid speelt een kleinere rol voor een bakkerij die brood verkoopt aan consumenten dan voor een leverancier in de kledingbranche waarbij klanten hun herfstcollectie al maanden geleden hebben besteld en levering verwachten.\u003c/li\u003e\n \u003cli\u003eAls je levert aan de detailhandel en een winkel heeft hiervoor een nieuw schap laten bouwen om jouw producten te kunnen verkopen.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch2\u003eJuiste moment\u003c/h2\u003e\n\n\u003cp\u003eOp \u003ca class=\"anchor-target\" href=\"/stoppen-en-uitschrijven/zo-kies-je-een-uitschrijfdatum/\" data-type=\"internal\"\u003ehet moment dat je weet dat je gaat stoppen\u003c/a\u003e, mag je geen nieuwe bestelling - en geen aanbetaling - meer aannemen waarvan je weet dat je niet aan de leverplicht kunt voldoen. Je moet bijvoorbeeld je webshop sluiten, als je weet dat je niet meer kunt leveren. Als je toch bestellingen aanneemt en (aan)betalingen laat voldoen zonder dat je levert maakt dit je priv\u0026#233; aansprakelijk. Dit kan zelfs \u003ca rel=\"noopener noreferrer\" href=\"http://www.wetboek-online.nl/wet/Wetboek%20van%20Strafrecht/326.html\" class=\"external-link\" target=\"_blank\"\u003eoplichting\u003c/a\u003e zijn.\u003c/p\u003e\n\n\u003cp\u003eJe wilt je klanten niet te vroeg en niet te laat informeren. Wanneer is het precies goed? De Hoge Raad gaat uit van het principe dat hoe eerder je aan je klant meldt dat je stopt, hoe minder schade je bij deze klant veroorzaakt. En hoe minder schadeplichtig je bent. Aan de andere kant loop je hiermee het risico dat je omzet al eerder wegvalt dan wenselijk is. De situatie kan ontstaan dat je drie maanden voor je daadwerkelijk stopt je klanten al verliest terwijl je nog wel je personeel, huur en auto moet betalen.\u003c/p\u003e\n\n\u003cp\u003eDe beste timing om je klant te informeren sluit aan bij je normale bestel- en levercyclus. Verkoop je dagelijks vers brood aan consumenten en is daarmee je transactie helemaal rond? Dan kun je \u0026#233;\u0026#233;n dag voor je stopt een briefje ophangen aan de deur. Lever je brood aan diverse restaurants, die om de paar dagen bij je bestellen, dan is dit niet voldoende. Hoe minder last je klant ondervindt van je bedrijfssluiting, hoe beter.\u003c/p\u003e\n\n\u003ch2\u003eDuidelijk verhaal\u003c/h2\u003e\n\n\u003cp\u003eVertel je klant dat je stopt en geef voor zover mogelijk duidelijkheid over praktische zaken. Benoem:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003ePer wanneer je stopt.\u003c/li\u003e\n \u003cli\u003eHoe het zit met de laatste bestellingen.\u003c/li\u003e\n \u003cli\u003eWaar een klant terecht kan met vragen.\u003c/li\u003e\n \u003cli\u003eWat er gebeurt met bewaarde persoonsgegevens.\u003c/li\u003e\n \u003cli\u003eVerwijs eventueel door naar een andere leverancier.\u0026#160; Worden de activiteiten van je bedrijf overgenomen? Dan is een verwijzing naar de overnemer een must als de overnamepartner goodwill betaalt voor je klantenbestand.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eZo help je jouw klanten weer op weg zodat ze minder gevolgen ervaren van je sluiting. Als je - een selectie van - je klanten al vroeg informeert dat je stopt, vraag ze dan of ze hiermee vertrouwelijk willen omgaan, omdat je nieuws in dit stadium nog niet algemeen bekend is.\u003c/p\u003e\n\n\u003ch3\u003eReden\u003c/h3\u003e\n\n\u003cp\u003eJe bent wettelijk niet verplicht om klanten te vertellen waarom je stopt. Als je dit wel deelt, levert dit begrip bij klanten op en neem je regie over je eigen verhaal. De ene ondernemer stopt met een feestje omdat hij de pensioengerechtigde leeftijd bereikt, en nodigt zijn klanten uit voor een afscheid waarbij hij terugblikt op alle mooie jaren. Een ander stopt om financi\u0026#235;le redenen, gezondheidsredenen of slaat een andere weg in. Als je een warme klantrelatie hebt, past een persoonlijk verhaal over je bedrijfssluiting. Dit kan op verschillende manieren. In een video waarin je jouw bedrijfssluiting uitlegt, bedankt en afscheid neemt. Of met een zakelijk persbericht dat je verspreidt in de media. Wat de reden ook is, kijk wat past bij jezelf, je verhaal, je bedrijf en je klanten.\u003c/p\u003e\n\n\u003ch2\u003eFaillissement of schuldsanering\u003c/h2\u003e\n\n\u003cp\u003eEen curator of bewindsvoerder die een \u003ca title=\"Schuldregelingen voor ondernemers\" class=\"anchor-target\" href=\"/zwaar-weer/het-minnelijk-traject-voor-ondernemers-met-schulden/\" data-type=\"internal\"\u003efaillissement\u003c/a\u003e of \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.overheid.nl/schuldsanering/\" class=\"external-link\" target=\"_blank\"\u003eschuldsanering\u003c/a\u003e afwikkelt heeft als taak zoveel mogelijk te betekenen voor schuldeisers en werknemers door bijvoorbeeld een doorstart te realiseren. De kans dat dit lukt is groter wanneer een ondernemer zijn klanten nog geen gedag heeft gezegd en de zaak en klantenbestand nog in tact zijn. Daarom gelden bij een faillissement en schuldsanering deze regels.\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eJe houdt je zaak en klantenbestand zo gezond mogelijk ook al weet je dat faillissement of schuldsanering is aangevraagd.\u003c/li\u003e\n \u003cli\u003eEr is geen verplichting om je klant over de situatie te vertellen, maar je mag geen bestelling of aanbetalingen aannemen die je niet meer kunt waarmaken of contracten aangaan die je niet kunt nakomen.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eDe curator of bewindsvoeder combineert uiteindelijk - als een doorstart lukt - het (slechte) nieuws dat je stopt met informatie over het goede nieuws van je doorstart. Daarmee probeert hij je klanten en goodwill te behouden. Daarna kun je jouw persoonlijke verhaal alsnog aan je klanten vertellen.\u003c/p\u003e\n\n\u003ch2\u003eActielijst en planning\u003c/h2\u003e\n\n\u003cp\u003ePrik een datum waarop je naar buiten communiceert dat je stopt en reken dan terug. Hierop baseer je jouw actielijst. Daarop schrijf je wie je informeert, wanneer en hoe. Denk ook aan lopende marketing- en communicatieuitingen naar klanten. Pas je boodschap daarin aan of zet ze stop. Bijvoorbeeld:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eonline marketingcampagnes\u003c/li\u003e\n \u003cli\u003eadvertenties en reclame-uitingen\u003c/li\u003e\n \u003cli\u003eje website, webshop en domeinhosting\u003c/li\u003e\n \u003cli\u003eautomatische e-mails\u003c/li\u003e\n \u003cli\u003esocialmedia-accounts\u003c/li\u003e\n \u003cli\u003esponsoractiviteiten\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eMaak een back-up van je bestanden wanneer je online uitingen uitzet of stopt. Of maak een screenshot van je website. Je actielijst voor het stoppen van je onderneming is groter dan alleen je klantcommunicatie. Lees alles over het \u003ca class=\"anchor-target\" href=\"/stoppen-en-uitschrijven/checklist-bedrijf-stoppen-regel-dit-eerst/\" data-type=\"internal\"\u003estoppen van je bedrijf\u003c/a\u003e.\u003c/p\u003e\n\n\u003ch2\u003eVideo Stoppen met je bedrijf\u003c/h2\u003e\n\n\u003cp\u003eStoppen met je bedrijf kan op verschillende manieren. Afhankelijk van je situatie, doorlooop je verschillende stappen. De video licht de stappen toe bij verkoop, schulden en als je zelf wilt stoppen.\u003c/p\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","headerLevel":"h3","introduction":{"contentType":"hippostd:html","value":""},"video":{"uuid":"00892a9f-979e-4c34-9b8d-9865477d326b"},"contentType":"kvkwebsite:video"},{"contentType":"hippostd:html","value":"\u003cp\u003eDit artikel kwam mede tot stand met hulp van Erik Jansen, advocaat bij Poelmann van den Broek advocaten in Nijmegen.\u003c/p\u003e"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"Stop je met ondernemen? Dan heeft dit gevolgen voor je klanten. Of dit nu consumenten, leveranciers of vaste afnemers zijn. Informeer ze dat je stopt. Hoe breng je dit bericht? Maak een overzicht, onderscheid wat je moet en wat je mag, bepaal het juiste moment en communiceer.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Maak een overzicht van al je klanten, onderscheid wat je moet en wat je mag, bepaal het juiste moment en communiceer.","title":"Hoe vertel ik mijn klanten dat ik stop?","image":null,"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"featuredCards":{"name":"kvkwebsite:featuredCards","displayName":"kvkwebsite:featuredCards","featuredCards":[{"uuid":"8232575f-cd03-4668-aabf-ea92aec9015d"},{"uuid":"316256ae-781a-4b1c-8d83-4ccf6267c95c"},{"uuid":"d31853ac-5bfa-419b-83f8-cc946eb8c102"}],"cards":[{"uuid":"8232575f-cd03-4668-aabf-ea92aec9015d"},{"uuid":"316256ae-781a-4b1c-8d83-4ccf6267c95c"},{"uuid":"d31853ac-5bfa-419b-83f8-cc946eb8c102"}],"title":"Anderen lezen ook","contentType":"kvkwebsite:featuredCards"},"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":4,"editorialPublicationDateWithDefault":1779785672435,"editorialModificationDate":1762849980000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1762849980000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Stoppen en uitschrijven","key":"6","contentType":"selection:listitem","id":"a45fcc76-fd4e-4d34-8120-2d98cdcccad2"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Geldzaken","key":"2","contentType":"selection:listitem","id":"72926466-9b4d-4d40-9eb4-bd80dcae2295"}],"transaction":[],"organization":[],"subject":[],"sector":[],"audience":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Micro-MKB","key":"2","contentType":"selection:listitem","id":"92f7f673-f3fd-4021-b827-bb7cb926679d"},{"name":"selection:listitem","displayName":"selection:listitem","label":"MKB","key":"3","contentType":"selection:listitem","id":"296c1685-798e-4ab5-9cf7-893d38cf092e"}],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","label":"How to","key":"5","contentType":"selection:listitem","id":"150773d7-db72-44cc-bd62-9aaa30298bf0"},"author":[{"name":"selection:listitem","displayName":"selection:listitem","label":"KVK Redactie","key":"kvk-redactie","contentType":"selection:listitem","id":"4285a63d-025a-4a42-82bf-51521a24e8ff"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Stoppen","key":"stoppen","contentType":"selection:listitem","id":"7fec2ef5-1a24-4817-8070-e64658c0680a"}],"lawOpenGovernment":[null]},"title":"Hoe vertel ik mijn klanten dat ik stop?","image":{"$ref":"#u501ab3e502294a9092f963e066b7071a"},"localeString":"nl","contentType":"kvkwebsite:inspirationDocument","systemCreationDate":1677750249345,"systemModificationDate":1779785665057,"systemPublicationDate":1779785672435,"id":"a7b1faf1-9fc9-447c-a790-79396f09e105"}},"u7d425d11f3a847cd972000669acac85f":{"type":"imageset","links":{},"meta":{},"data":{"name":"beeld-stoppen-uittreden-vennoot-2.jpg","displayName":"beeld-stoppen-uittreden-vennoot-2.jpg","regular":{"name":"kvkwebsite:regular","displayName":"kvkwebsite:regular","width":800,"height":600,"lastModified":1731941267404,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":47919,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/regular/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"wide":{"name":"kvkwebsite:wide","displayName":"kvkwebsite:wide","width":1440,"height":810,"lastModified":1731941267404,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":93630,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/wide/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"extraWide":{"name":"kvkwebsite:extraWide","displayName":"kvkwebsite:extraWide","width":1440,"height":617,"lastModified":1765438305411,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":68346,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/extraWide/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"flexHeight":{"name":"kvkwebsite:flexHeight","displayName":"kvkwebsite:flexHeight","width":1440,"height":810,"lastModified":1764678680400,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":93630,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/flexHeight/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"photo":{"name":"kvkwebsite:photo","displayName":"kvkwebsite:photo","width":800,"height":533,"lastModified":1764678680745,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":41962,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/photo/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"openGraph":{"name":"kvkwebsite:openGraph","displayName":"kvkwebsite:openGraph","width":1200,"height":630,"lastModified":1731941267404,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":67538,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/openGraph/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"fileName":"beeld-stoppen-uittreden-vennoot-2.jpg","description":"","thumbnail":{"name":"hippogallery:thumbnail","displayName":"hippogallery:thumbnail","width":60,"height":33,"lastModified":1731941267404,"mimeType":"image/jpeg","filename":"beeld-stoppen-uittreden-vennoot-2.jpg","contentType":"hippogallery:image","size":3796,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/thumbnail/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"original":{"name":"hippogallery:original","displayName":"hippogallery:original","width":1920,"height":1080,"lastModified":1731941267404,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":371759,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/content/gallery/kvkwebsite-nl/paginas/stoppen/beeld-stoppen-uittreden-vennoot-2.jpg","type":"resource"}}},"contentType":"kvkwebsite:imageSet","localeString":null,"id":"7d425d11-f3a8-47cd-9720-00669acac85f"}},"u9fc8e006d0484353bad2744003847ace":{"type":"imageset","links":{},"meta":{},"data":{"name":"graph-stroomschema-schulden.svg","displayName":"graph-stroomschema-schulden.svg","fileName":"graph-stroomschema-schulden.svg","description":null,"thumbnail":{"name":"hippogallery:thumbnail","displayName":"hippogallery:thumbnail","width":60,"height":60,"lastModified":1680790355442,"mimeType":"image/svg+xml","filename":"graph-stroomschema-schulden.svg","contentType":"hippogallery:image","size":378927,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/thumbnail/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/svg-afbeeldingen/graph-stroomschema-schulden.svg","type":"resource"}}},"original":{"name":"hippogallery:original","displayName":"hippogallery:original","width":0,"height":0,"lastModified":1680790355442,"mimeType":"image/svg+xml","filename":null,"contentType":"hippogallery:image","size":378927,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/svg-afbeeldingen/graph-stroomschema-schulden.svg","type":"resource"}}},"contentType":"kvkwebsite:svgImageSet","localeString":null,"id":"9fc8e006-d048-4353-bad2-744003847ace"}},"u76ba5b56bd0144db86287dbd91ed1d6d":{"type":"document","links":{"site":{"href":"/zwaar-weer/dreigt-jouw-bedrijf-failliet-te-gaan-de-whoa-biedt-uitkomst/","type":"internal"}},"meta":{},"data":{"name":"dreigt-jouw-bedrijf-failliet-te-gaan-de-whoa-biedt-uitkomst","displayName":"Dreigt jouw bedrijf failliet te gaan? De WHOA biedt uitkomst","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Dreigt jouw bedrijf failliet te gaan? De WHOA biedt uitkomst","seodescription":"De Wet Homologatie Onderhands Akkoord (WHOA) helpt bedrijven die door hoge schulden failliet dreigen te gaan, terwijl ze nog wel levensvatbaar zijn.","seonoindex":true,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003cp\u003eWe zien Joep. Zijn bedrijf draait al maanden verlies door de gevolgen van het coronavirus. Hij is niet van plan te stoppen en belt KVK voor advies. Samen met een KVK-adviseur bekijkt hij de WHOA-routekaart en doorloopt de stappen. Joep maakt een toekomstbestendig plan en presenteert dit aan zijn schuldeisers. Voldoende schuldeisers gaan akkoord waardoor de rechter zijn plan homologeert (goedkeurt). Nu kan Joep weer verder met ondernemen.\u003c/p\u003e"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":null,"intro":"De Wet Homologatie Onderhands Akkoord (WHOA) helpt bedrijven die door hoge schulden failliet dreigen te gaan, terwijl ze nog wel levensvatbaar zijn. De WHOA maakt het mogelijk om zonder instemming van alle schuldeisers een akkoord te bereiken op een schuldregeling. Ook bedrijven met onvoldoende overlevingskansen hebben baat bij de nieuwe wet, omdat zij zonder faillissement kunnen stoppen.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Ondernemer Joep gebruikt de Wet Homologatie Onderhands Akkoord om zijn bedrijf er weer bovenop te krijgen.","title":"Dreigt jouw bedrijf failliet te gaan? De WHOA biedt uitkomst","image":{"$ref":"#u17c2538273d34cada077233850c7d0af"},"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"youTube":{"name":"kvkwebsite:youTube","displayName":"kvkwebsite:youTube","duration":{"name":"kvkwebsite:duration","displayName":"kvkwebsite:duration","seconds":11,"minutes":2,"contentType":"kvkwebsite:duration"},"labels":{"videoRegardingSubject":"Video met het onderwerp","cookieLinkText":"Lees meer over onze cookieverklaring","cookieLinkTextSmall":"Onze cookieverklaring","acceptButtonText":"Alle cookies accepteren","introductionText":"Door jouw cookie-instellingen kun je deze video helaas niet bekijken. Wil je de video toch bekijken?","youtubeButtonText":"Bekijk op YouTube","videoWithoutTitle":"Video zonder titel","middleText":"of"},"videoId":"WE4tpD6viO0","contentType":"kvkwebsite:youTube"},"relatedDocuments":[],"videoSerie":[],"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":1,"editorialPublicationDateWithDefault":1770729885990,"editorialModificationDate":1684105200000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1684105200000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Zwaar weer","key":"4","contentType":"selection:listitem","id":"a3d9a0fa-044c-442a-8101-29b379a94ef0"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Wetten en regels","key":"7","contentType":"selection:listitem","id":"b5e427ce-fd44-4907-9c48-19c36a4dd9d8"}],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Schulden","key":"45","contentType":"selection:listitem","id":"08568092-e45b-4f02-b93d-aa410c861200"}],"sector":[],"audience":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Micro-MKB","key":"2","contentType":"selection:listitem","id":"92f7f673-f3fd-4021-b827-bb7cb926679d"}],"articleType":null,"author":[],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Thunderbirds","key":"thunderbirds","contentType":"selection:listitem","id":"d528e480-7dad-4837-a4a6-ab704062d7d7"}],"lawOpenGovernment":[null]},"title":"Dreigt jouw bedrijf failliet te gaan? De WHOA biedt uitkomst","localeString":"nl","contentType":"kvkwebsite:videoDocument","systemCreationDate":1677855030097,"systemModificationDate":1770729878753,"systemPublicationDate":1770729885990,"id":"76ba5b56-bd01-44db-8628-7dbd91ed1d6d"}},"u283a7cf071d74c73aabf9310fce3fa3a":{"type":"document","links":{"site":{"href":"/zwaar-weer/faillissement-kom-in-actie-video/","type":"internal"}},"meta":{},"data":{"name":"faillissement-kom-in-actie-video","displayName":"Faillissement? Kom in actie | KVK","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Faillissement? Kom in actie | KVK","seodescription":"Soms is een faillissement de beste optie. In deze animatie leggen we uit hoe dat precies werkt.","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":null,"intro":"Pim kan zijn huur en elektriciteit niet meer betalen en heeft oplopende schulden bij meerdere schuldeisers. Met zijn financieel adviseur stuit hij via KVK.nl op het Stroomschema Schulden. Hij ontdekt dat faillissement in zijn situatie de beste optie is. Maar hoe werkt dat precies?","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Soms is een faillissement de beste optie. In deze animatie leggen we uit hoe dat precies werkt.","title":"Faillissement? Kom in actie | KVK","image":{"$ref":"#u2a6123575e474249b6fd377ddb011615"},"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"youTube":{"name":"kvkwebsite:youTube","displayName":"kvkwebsite:youTube","duration":{"name":"kvkwebsite:duration","displayName":"kvkwebsite:duration","seconds":20,"minutes":2,"contentType":"kvkwebsite:duration"},"labels":{"videoRegardingSubject":"Video met het onderwerp","cookieLinkText":"Lees meer over onze cookieverklaring","cookieLinkTextSmall":"Onze cookieverklaring","acceptButtonText":"Alle cookies accepteren","introductionText":"Door jouw cookie-instellingen kun je deze video helaas niet bekijken. Wil je de video toch bekijken?","youtubeButtonText":"Bekijk op YouTube","videoWithoutTitle":"Video zonder titel","middleText":"of"},"videoId":"Yw6ut8T_VpU","contentType":"kvkwebsite:youTube"},"relatedDocuments":[],"videoSerie":[],"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":1,"editorialPublicationDateWithDefault":1770370056757,"editorialModificationDate":1684105200000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1684105200000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Zwaar weer","key":"4","contentType":"selection:listitem","id":"a3d9a0fa-044c-442a-8101-29b379a94ef0"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Geldzaken","key":"2","contentType":"selection:listitem","id":"72926466-9b4d-4d40-9eb4-bd80dcae2295"}],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Schulden","key":"45","contentType":"selection:listitem","id":"08568092-e45b-4f02-b93d-aa410c861200"}],"sector":[],"audience":[{"name":"selection:listitem","displayName":"selection:listitem","label":"ZZP","key":"1","contentType":"selection:listitem","id":"b03acec6-5662-43ab-a10d-e2e22c7f0da5"},{"name":"selection:listitem","displayName":"selection:listitem","label":"Micro-MKB","key":"2","contentType":"selection:listitem","id":"92f7f673-f3fd-4021-b827-bb7cb926679d"},{"name":"selection:listitem","displayName":"selection:listitem","label":"MKB","key":"3","contentType":"selection:listitem","id":"296c1685-798e-4ab5-9cf7-893d38cf092e"}],"articleType":null,"author":[],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Thunderbirds","key":"thunderbirds","contentType":"selection:listitem","id":"d528e480-7dad-4837-a4a6-ab704062d7d7"}],"lawOpenGovernment":[null]},"title":"Faillissement? Kom in actie | KVK","localeString":"nl","contentType":"kvkwebsite:videoDocument","systemCreationDate":1687439343093,"systemModificationDate":1770370050198,"systemPublicationDate":1770370056757,"id":"283a7cf0-71d7-4c73-aabf-9310fce3fa3a"}},"u80ee65e973fc4e238542fe6b9f876e61":{"type":"document","links":{"site":{"href":"/zwaar-weer/je-bedrijf-in-de-problemen-hier-vind-je-hulp/","type":"internal"}},"meta":{},"data":{"name":"je-bedrijf-in-de-problemen-hier-vind-je-hulp","displayName":"Je bedrijf in de problemen? Hier vind je hulp","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Je bedrijf in de problemen? Hier vind je hulp","seodescription":"Hulp voor ondernemers met geldproblemen. Je vindt hier een overzicht met organisaties die jou verder helpen.","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003ch2\u003eKies een onderwerp waar jij hulp voor zoekt\u003c/h2\u003e\n\n\u003cp\u003eAls het minder gaat met je bedrijf en er financi\u0026#235;le problemen ontstaan, is het belangrijk dat je daar zo snel mogelijk wat aan doet. Want hoe langer je wacht, hoe moeilijker het is om een oplossing te vinden. Er zijn allerlei orgnisaties die jou kunnen helpen.\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003e\u003ca href=\"/zwaar-weer/je-bedrijf-in-de-problemen-hier-vind-je-hulp/#geldzorgen\"\u003eFinanci\u0026#235;le problemen en schulden\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"/zwaar-weer/je-bedrijf-in-de-problemen-hier-vind-je-hulp/#administratie\"\u003eAdministratie en bedrijfsvoering\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"/zwaar-weer/je-bedrijf-in-de-problemen-hier-vind-je-hulp/#coaching\"\u003eCoaching voor ondernemers\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"/zwaar-weer/je-bedrijf-in-de-problemen-hier-vind-je-hulp/#mentaal\"\u003eMentale problemen\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","content":{"contentType":"hippostd:html","value":"\u003cp\u003eZit je met vragen over je onderneming? Spar met de ervaren adviseurs van het KVK Adviesteam, ook als het niet goed gaat met je bedrijf. Bel 088 585 22 22.\u003c/p\u003e"},"title":"Bel met het KVK Adviesteam","contentType":"kvkwebsite:kader"},{"contentType":"hippostd:html","value":"\u003ch2\u003e\u003ca name=\"geldproblemen\" id=\"geldproblemen\" class=\"anchor-target\"\u003eHulp bij financi\u0026#235;le problemen en schulden\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eHeeft je bedrijf financi\u0026#235;le problemen of zijn er\u0026#160;schulden? Voor hulp kun je terecht bij:\u003c/p\u003e\n\n\u003cdiv\u003e\u003ctable border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width:731.818px\"\u003e\n \u003cthead\u003e\n  \u003ctr\u003e\n   \u003cth scope=\"col\" style=\"width:107px\"\u003eOrganisatie\u003c/th\u003e\n   \u003cth scope=\"col\" style=\"width:615px\"\u003eSoort hulpverlening\u003c/th\u003e\n  \u003c/tr\u003e\n \u003c/thead\u003e\n \u003ctbody\u003e\n \u003c/tbody\u003e\n \u003ctbody\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:107px\"\u003eGemeente\u003c/td\u003e\n   \u003ctd style=\"width:615px\"\u003eDe gemeente kan met je meedenken en helpen als je schulden hebt of je zorgen maakt over geld. Dat is een\u0026#160;\u003ca class=\"anchor-target\" href=\"/zwaar-weer/schulden-de-gemeente-helpt-je-vooruit/\" data-type=\"internal\"\u003ewettelijke taak\u003c/a\u003e. Bijvoorbeeld hulp bij tijdelijke financi\u0026#235;le ondersteuning, schulden, het aanpassen of stoppen van je bedrijf of omscholen naar ander werk. Je kunt ook begeleiding krijgen van een budgetcoach. Neem contact op met de gemeente waar je woont\u0026#160;om te kijken wat er in jouw situatie mogelijk is.\u003c/td\u003e\n  \u003c/tr\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:107px\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://geldfit.nl/zakelijk/?utm_medium=partnerzakelijk\u0026#38;utm_source=kvk\u0026#38;utm_campaign= website-naam-van-pagina\" class=\"external-link\" target=\"_blank\"\u003eGeldfit Zakelijk\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:615px\"\u003eGeldfit Zakelijk geeft ondernemers weer grip op de financi\u0026#235;le situatie van hun bedrijf.\u003cbr /\u003e\n   Via\u0026#160;een gratis adviesgesprek of bedrijfsanalyse zie je wat je kunt doen. Bijvoorbeeld\u0026#160;\u003cbr /\u003e\n   begeleiding, financiering, juridisch advies of een schuldregeling.\u003c/td\u003e\n  \u003c/tr\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:107px\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://www.155.nl/\" class=\"external-link\" target=\"_blank\"\u003eStichting 155\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:615px\"\u003eStichting 155 is een hulplijn voor ondernemers die even vastlopen. Ze geven advies\u003cbr /\u003e\n   als je omzet\u0026#160;daalt, schulden hebt of je klanten niet betalen. Het eerste gesprek is\u003cbr /\u003e\n   gratis.\u0026#160;Met online tools\u0026#160;kun je zelf kijken hoe je bedrijf er financieel voor staat.\u003c/td\u003e\n  \u003c/tr\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:107px\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://www.overrood.nl/\" class=\"external-link\" target=\"_blank\"\u003eOver Rood\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:615px\"\u003eOver Rood is een vrijwilligersorganisatie voor ondernemers, door ondernemers. De\u003cbr /\u003e\n   stichting\u0026#160;begeleidt en ondersteunt ondernemers naar een financieel gezonde\u003cbr /\u003e\n   toekomst. Met coaching, workshops en trainingen.\u003c/td\u003e\n  \u003c/tr\u003e\n \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003ch2\u003e\u003ca name=\"administratie\" id=\"administratie\" class=\"anchor-target\"\u003eHulp bij administratie en bedrijfsvoering\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eWil je je bedrijfsvoering verbeteren? Verschillende organisaties geven informatie en bieden hulp. Bijvoorbeeld met advies over financi\u0026#235;n of personeel.\u003c/p\u003e\n\n\u003cdiv\u003e\u003ctable border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width:732.818px\"\u003e\n \u003cthead\u003e\n  \u003ctr\u003e\n   \u003cth scope=\"col\" style=\"width:105px\"\u003eOrganisatie\u003c/th\u003e\n   \u003cth scope=\"col\" style=\"width:618px\"\u003eSoort hulpverlening\u003c/th\u003e\n  \u003c/tr\u003e\n \u003c/thead\u003e\n \u003ctbody\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:105px\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://geldfit.nl/zakelijk/\" class=\"external-link\" target=\"_blank\"\u003eGeldfit Zakelijk\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:618px\"\u003eGeldfit Zakelijk geeft ondernemers weer grip op de financi\u0026#235;le situatie van hun bedrijf.\u003cbr /\u003e\n   Gebruik de\u0026#160;gratis online test van Geldfit Zakelijk om te ontdekken hoe je bedrijf er\u003cbr /\u003e\n   financieel voor staat.\u003c/td\u003e\n  \u003c/tr\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:105px\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://www.nvvbs.nl/zakelijk/\" class=\"external-link\" target=\"_blank\"\u003eNVVBS\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:618px\"\u003eEen budgetcoach helpt je met je financi\u0026#235;n en\u0026#160;administratie. En\u0026#160;zorgt\u0026#160;voor\u0026#160;overzicht\u003cbr /\u003e\n   in je inkomsten en uitgaven. Een budgetcoach is niet gratis. Bij de\u0026#160;Nederlandse\u003cbr /\u003e\n   Vereniging van Budgetcoaches Schuldhulpverleners vind je\u0026#160;gekwalificeerde\u0026#160;coaches.\u003c/td\u003e\n  \u003c/tr\u003e\n \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003ch2\u003e\u003ca name=\"coaching\" id=\"coaching\" class=\"anchor-target\"\u003eHulp via coaching voor ondernemers\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eDe volgende organisaties bieden coaching aan voor jou en je bedrijf:\u003c/p\u003e\n\n\u003cdiv\u003e\u003ctable border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width:731.818px\"\u003e\n \u003cthead\u003e\n  \u003ctr\u003e\n   \u003cth scope=\"col\"\u003eOrganisatie\u003c/th\u003e\n   \u003cth scope=\"col\" style=\"width:571px\"\u003eSoort hulpverlening\u003c/th\u003e\n  \u003c/tr\u003e\n \u003c/thead\u003e\n \u003ctbody\u003e\n  \u003ctr\u003e\n   \u003ctd\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersklankbord.nl/\" class=\"external-link\" target=\"_blank\"\u003eOndernemersklankbord (OKB)\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:571px\"\u003eOKB\u0026#160;begeleidt je voor een periode van\u0026#160;zes maanden. Dat kan in elke\u003cbr /\u003e\n   fase\u0026#160;van je bedrijf: van starten tot bedrijfsopvolging. En van\u003cbr /\u003e\n   doorgroeien\u0026#160;tot\u0026#160;reorganiseren.\u0026#160;Je krijgt een oud-ondernemer of\u003cbr /\u003e\n   specialist uit je eigen\u0026#160;regio\u0026#160;als adviseur. De\u0026#160;kosten zijn\u0026#160;200 euro,\u003cbr /\u003e\n   de\u0026#160;intake is gratis.\u003c/td\u003e\n  \u003c/tr\u003e\n  \u003ctr\u003e\n   \u003ctd\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://qredits.nl/over-qredits/contact/qredits-crisiscoach/\" class=\"external-link\" target=\"_blank\"\u003eQredits\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:571px\"\u003eEen Qredits-coach helpt je met verschillende bedrijfsonderdelen zoals\u003cbr /\u003e\n   marketing,\u0026#160;financi\u0026#235;n en strategie.\u0026#160;Als je al een krediet of lening bij\u003cbr /\u003e\n   Qredits\u0026#160;hebt, is de coaching\u0026#160;gratis. Anders kost het 200 euro.\u003c/td\u003e\n  \u003c/tr\u003e\n  \u003ctr\u003e\n   \u003ctd\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://www.nlgroeit.nl/\" class=\"external-link\" target=\"_blank\"\u003eNlgroeit\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:571px\"\u003eNlgroeit helpt bedrijven die (willen) groeien en ontwikkelen. Je krijgt\u003cbr /\u003e\n   een\u0026#160;mentor\u0026#160;die bij je bedrijf en\u0026#160;wensen past. Jullie stippelen\u0026#160;samen\u003cbr /\u003e\n   het\u0026#160;begeleidingstraject uit.\u003c/td\u003e\n  \u003c/tr\u003e\n \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e\n\n\u003ch2\u003e\u003ca name=\"mentaal\" id=\"mentaal\" class=\"anchor-target\"\u003eHulp bij mentale problemen\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eEen crisis in je bedrijf raakt je niet alleen zakelijk, maar ook persoonlijk en emotioneel. Het helpt om over je problemen te praten. Bijvoorbeeld met familie, vrienden of collega-ondernemers. Je kunt ook altijd bij je huisarts of gemeente terecht. Of kies:\u003c/p\u003e\n\n\u003cdiv\u003e\u003ctable border=\"1\" cellpadding=\"1\" cellspacing=\"1\" style=\"width:729.818px\"\u003e\n \u003cthead\u003e\n  \u003ctr\u003e\n   \u003cth scope=\"col\" style=\"width:151px\"\u003eOrganisatie\u003c/th\u003e\n   \u003cth scope=\"col\" style=\"width:569px\"\u003eSoort hulpverlening\u003c/th\u003e\n  \u003c/tr\u003e\n \u003c/thead\u003e\n \u003ctbody\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:151px\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://www.deluisterlijn.nl/\" class=\"external-link\" target=\"_blank\"\u003eDe Luisterlijn\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:569px\"\u003eDe vrijwilligers van de Luisterlijn zijn er voor een luisterend oor en\u0026#160;een\u0026#160;goed\u0026#160;gesprek.\u003cbr /\u003e\n   Ook als je geldzorgen hebt en je daardoor onzeker\u0026#160;voelt.\u0026#160;Bel\u0026#160;088 0767 000.\u003c/td\u003e\n  \u003c/tr\u003e\n  \u003ctr\u003e\n   \u003ctd style=\"width:151px\"\u003e\u003ca rel=\"noopener noreferrer\" href=\"https://mindkorrelatie.nl/\" class=\"external-link\" target=\"_blank\"\u003eMIND Hulplijn\u003c/a\u003e\u003c/td\u003e\n   \u003ctd style=\"width:569px\"\u003eMIND heeft psychologen en maatschappelijk werkers die luisteren,\u0026#160;adviseren\u0026#160;en\u003cbr /\u003e\n   verwijzen naar passende hulp. Bijvoorbeeld als\u0026#160;geldproblemen\u0026#160;zorgen\u0026#160;voor\u003cbr /\u003e\n   spanningen.\u0026#160;Bel 0900 1450.\u003c/td\u003e\n  \u003c/tr\u003e\n \u003c/tbody\u003e\n\u003c/table\u003e\u003c/div\u003e"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"Heeft je bedrijf geldproblemen of maak je je zorgen over je bedrijf? Dat is vervelend, maar het komt vaker voor dan je denkt. Weet dat je niet alles alleen hoeft op te lossen. KVK biedt hulp door naar jou te luisteren. Ook werkt KVK samen met organisaties die je kunnen helpen met advies en coaching. Ontdek wat dit professionele hulpnetwerk voor jou kan betekenen.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Er zijn verschillende organisaties die hulp bieden aan ondernemers met financiële problemen. Je ziet ze op een rij in een handig overzicht. Lees meer.","title":"Je bedrijf in de problemen? Hier vind je hulp","image":null,"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"featuredCards":{"name":"kvkwebsite:featuredCards","displayName":"kvkwebsite:featuredCards","featuredCards":[{"uuid":"a9536cfd-0fe5-46ea-8197-11760fe8c92f"},{"uuid":"aa39e67d-292f-4657-8ffd-8dd5f3bae75d"},{"uuid":"4a76f9c5-6fcc-4695-a8b9-468d18009003"}],"cards":[{"uuid":"a9536cfd-0fe5-46ea-8197-11760fe8c92f"},{"uuid":"aa39e67d-292f-4657-8ffd-8dd5f3bae75d"},{"uuid":"4a76f9c5-6fcc-4695-a8b9-468d18009003"}],"title":"Anderen lezen ook","contentType":"kvkwebsite:featuredCards"},"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":3,"editorialPublicationDateWithDefault":1782825038251,"editorialModificationDate":1782820380000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1782820380000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Zwaar weer","key":"4","contentType":"selection:listitem","id":"a3d9a0fa-044c-442a-8101-29b379a94ef0"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Geldzaken","key":"2","contentType":"selection:listitem","id":"72926466-9b4d-4d40-9eb4-bd80dcae2295"}],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Schulden","key":"45","contentType":"selection:listitem","id":"08568092-e45b-4f02-b93d-aa410c861200"}],"sector":[],"audience":[],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","label":"De basis","key":"3","contentType":"selection:listitem","id":"36b33655-ebee-4dc1-b216-6c80c22f907e"},"author":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Gé Sletterink","key":"ge-sletterink","contentType":"selection:listitem","id":"da0b4071-b4c4-4453-a713-ca5b452b8e29"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Thunderbirds","key":"thunderbirds","contentType":"selection:listitem","id":"d528e480-7dad-4837-a4a6-ab704062d7d7"}],"lawOpenGovernment":[null]},"title":"Je bedrijf in de problemen? Hier vind je hulp bij ondernemen","image":{"$ref":"#uab931fa027cd4544a900c426e252829e"},"localeString":"nl","contentType":"kvkwebsite:inspirationDocument","systemCreationDate":1675946968584,"systemModificationDate":1782825033877,"systemPublicationDate":1782825038251,"id":"80ee65e9-73fc-4e23-8542-fe6b9f876e61"}},"u1be521a63e6d4823bbb9cefcd78b9f42":{"type":"document","links":{"site":{"href":"/zwaar-weer/op-de-rand-van-faillissement-de-whoa-biedt-uitkomst/","type":"internal"}},"meta":{},"data":{"name":"op-de-rand-van-faillissement-de-whoa-biedt-uitkomst","displayName":"Op de rand van faillissement? De WHOA biedt uitkomst","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Hoe werkt de WHOA?","seodescription":"Met de Wet Homologatie Onderhands Akkoord (WHOA) kun je faillissement voorkomen. Zo werkt het.","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003ch2\u003eWat is de WHOA?\u003c/h2\u003e\n\n\u003cp\u003eDe WHOA is een wettelijke regeling waarmee je als ondernemer je schulden kunt herstructureren. Met de WHOA kun je afspraken maken met je \u003cabbr tooltip=\"Iemand die nog geld moet krijgen.\" title=\"Iemand die nog geld moet krijgen.\"\u003eschuldeisers\u003c/abbr\u003e om:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eeen deel van je schulden te betalen\u003c/li\u003e\n \u003cli\u003eeen deel van je schulden kwijt te schelden\u003c/li\u003e\n \u003cli\u003eeen deel van je schulden later te betalen\u003c/li\u003e\n \u003cli\u003eschulden om te zetten in aandelen (bij rechtspersonen)\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eJe hoeft niet met al je schuldeisers afspraken te maken. Je verdeelt ze in klassen (groepen) op basis van hun \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.overheid.nl/geldzaken-en-belastingen/financiele-problemen/rangorde-schuldeisers/\" class=\"external-link\" target=\"_blank\"\u003erechten en rangorde\u003c/a\u003e. Bijvoorbeeld de Belastingdienst, banken, leveranciers. Je biedt je akkoord aan \u0026#233;\u0026#233;n of meerdere klassen aan.\u003c/p\u003e\n\n\u003cp\u003e\u003cspan\u003e\u003cspan\u003e\u003cspan\u003eAls de rechter het akkoord goedkeurt, wordt dit homologatie genoemd. Het akkoord geldt dan voor alle schuldeisers in de klasse, ook als zij niet allemaal akkoord gaan. Dat heet een dwangakkoord.\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/p\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","headerLevel":"h2","introduction":{"contentType":"hippostd:html","value":""},"video":{"$ref":"#u76ba5b56bd0144db86287dbd91ed1d6d"},"contentType":"kvkwebsite:video"},{"contentType":"hippostd:html","value":"\u003ch2\u003eVoor wie is de WHOA?\u003c/h2\u003e\n\n\u003cp\u003eBedrijven in elke rechtsvorm hebben toegang tot de WHOA. Van eenmanszaak tot bv. Voor kleinere zelfstandigen kunnen de advieskosten voor de begeleiding van een WHOA-traject een belemmering zijn.\u003c/p\u003e\n\n\u003ch2\u003eWanneer is de WHOA geschikt?\u003c/h2\u003e\n\n\u003cp\u003eDe WHOA kun je gebruiken als je structurele betalingsproblemen hebt en er een faillissement dreigt. Ook moet je een concreet en onderbouwd akkoord kunnen aanbieden. En kunnen inschatten dat schuldeisers met het akkoord niet slechter af zijn dan bij een faillissement.\u0026#160;De rechter toetst dit bij de beoordeling van het verzoek tot homologatie.\u003c/p\u003e\n\n\u003ch3\u003eTwee soorten akkoorden\u003c/h3\u003e\n\n\u003cp\u003eIn een WHOA-traject kun je kiezen tussen twee soorten akkoorden. Welke je kiest hangt af van de situatie van je bedrijf.\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003e\n \u003cp\u003eReorganisatieakkoord\u003cbr /\u003e\n Is je bedrijf in de kern levensvatbaar? Dan kun je met een reorganisatieakkoord schulden saneren en doorgaan met ondernemen. Tijdens het traject blijf je zelf bevoegd om je bedrijf te leiden. Je krijgt niet automatisch een \u003cabbr tooltip=\"Iemand die beslissingen neemt over het geld van iemand anders.\" title=\"Iemand die beslissingen neemt over het geld van iemand anders.\"\u003ecurator\u003c/abbr\u003e.\u003c/p\u003e\n \u003c/li\u003e\n \u003cli\u003eLiquidatieakkoord\u003cbr /\u003e\n Is doorgaan met je bedrijf niet haalbaar? Dan kun je met een liquidatieakkoord je bedrijf gecontroleerd afronden. Dit kan een alternatief zijn voor een faillissement. Schuldeisers krijgen bij een WHOA-traject vaak meer uitgekeerd dan bij een faillissement.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch2\u003eHoe werkt de WHOA? De belangrijkste stappen\u003c/h2\u003e\n\n\u003cp\u003eEen WHOA-traject heeft vaste wettelijke stappen:\u003c/p\u003e\n\n\u003col\u003e\n \u003cli\u003eStartverklaring deponeren bij de rechtbank. Daarmee laat je zien dat\u0026#160;je een akkoord voorbereidt.\u003c/li\u003e\n \u003cli\u003eFinanci\u0026#235;le situatie in kaart brengen. Je maakt een overzicht van je schulden, bezittingen en vooruitzichten.\u003c/li\u003e\n \u003cli\u003eSchuldeisers indelen in klassen. Je maakt groepen van je schuldeisers op basis van hun rechten en rang, bijvoorbeeld:\n \u003cul\u003e\n  \u003cli\u003eseparatisten (pand- en hypotheekhouders)\u003c/li\u003e\n  \u003cli\u003epreferente schuldeisers (zoals de Belastingdienst)\u003c/li\u003e\n  \u003cli\u003econcurrente schuldeisers\u003c/li\u003e\n \u003c/ul\u003e\n \u003c/li\u003e\n \u003cli\u003eConceptakkoord opstellen en stemmen per klasse. Je biedt een akkoord aan een of meerdere klassen van schuldeisers aan. Elke klasse stemt over het akkoord. Een klasse stemt in\u0026#160;als ten minste tweederde van het totale bedrag aan vorderingen binnen die klasse v\u0026#243;\u0026#243;r stemt.\u003c/li\u003e\n \u003cli\u003eHomologatieverzoek bij de rechtbank. Aanvraag tot goedkeuring van het akkoord. Dit gaat via een advocaat.\u003c/li\u003e\n \u003cli\u003eUitvoering van het akkoord. Na goedkeuring door de rechter is het akkoord bindend. Het geldt dan voor alle betrokken partijen.\u003c/li\u003e\n\u003c/ol\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","content":{"contentType":"hippostd:html","value":"\u003cp\u003eIn het \u003ca class=\"anchor-target\" href=\"/zwaar-weer/stappenplan-whoa-aanvragen/\" data-type=\"internal\"\u003eStappenplan WHOA aanvragen\u003c/a\u003e\u0026#160;lees je per stap wat je zelf kunt doen, waar je een advocaat bij nodig hebt en hoe lang elke stap duurt.\u003c/p\u003e"},"title":"Stappenplan WHOA aanvragen","contentType":"kvkwebsite:kader"},{"contentType":"hippostd:html","value":"\u003ch2\u003eWat mag en moet binnen de WHOA?\u003c/h2\u003e\n\n\u003cp\u003eDe wet stelt duidelijke voorwaarden:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eJe mag zelf bepalen welke groepen schuldeisers je een voorstel doet. Schuldeisers die je niet benadert, houden recht op volledige betaling.\u003c/li\u003e\n \u003cli\u003eSchuldeisers die kleine mkb‑ondernemers (tot 50 medewerkers) zijn, moeten minimaal 20% van hun vordering terugkrijgen.\u003c/li\u003e\n \u003cli\u003eLopende overeenkomsten, zoals huurcontracten, kun je onder voorwaarden aanpassen of be\u0026#235;indigen als de rechter dat goed vindt.\u003c/li\u003e\n \u003cli\u003eVia de\u0026#160;WHOA mag je arbeidsvoorwaarden niet veranderen. Ook vallen niet-betaalde pensioenpremies vallen het akkoord.\u003c/li\u003e\n \u003cli\u003eWordt het akkoord niet gehomologeerd? Dan kun je drie jaar lang geen nieuw WHOA-verzoek indienen voor dezelfde schuldenpositie.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch3\u003eLet op bij borg en priv\u0026#233;‑aansprakelijkheid\u003c/h3\u003e\n\n\u003cp\u003eHeb je priv\u0026#233; meegetekend voor een schuld van je bv of andere rechtspersoon? Bijvoorbeeld als directeur-grootaandeelhouder (dga)? Dan heft een WHOA-akkoord deze persoonlijke verplichting niet op. Dat betekent dat een schuldeiser na een WHOA‑akkoord alsnog bij jou priv\u0026#233; kan aankloppen voor het deel dat in het akkoord niet wordt terugbetaald.\u003c/p\u003e\n\n\u003ch2\u003eWie kan een WHOA-traject starten?\u003c/h2\u003e\n\n\u003cp\u003eEen WHOA-traject kan worden gestart door:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003ede ondernemer zelf\u003c/li\u003e\n \u003cli\u003eeen schuldeiser\u003c/li\u003e\n \u003cli\u003eeen aandeelhouders\u003c/li\u003e\n \u003cli\u003ede ondernemingsraad of personeelsvertegenwoordiging\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eDe rechtbank kan op verzoek een herstructureringsdeskundige aanwijzen die een akkoord voorbereidt en aanbiedt.\u003c/p\u003e\n\n\u003ch2\u003eWie heb je nodig?\u003c/h2\u003e\n\n\u003cp\u003eJe kunt een deel van het WHOA-traject zelf uitvoeren, maar hebt meestal hulp nodig van verschillende deskundigen:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eAdvocaat: verplicht nodig voor het indienen van het homologatieverzoek.\u003c/li\u003e\n \u003cli\u003eHerstructureringsdeskundige: voor de voorbereiding van het conceptakkoord. Deze kan door de rechtbank benoemd worden.\u003c/li\u003e\n \u003cli\u003eFinancieel adviseur of accountant: voor inzicht in de schulden, waardering van het bedrijf en haalbaarheid van het akkoord.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch2\u003eWHOA of faillissement?\u003c/h2\u003e\n\n\u003cp\u003eBij \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.overheid.nl/bedrijf-stoppen-of-overdragen/faillissement/hoe-werkt-een-faillissement-verloop-procedure/\" class=\"external-link\" target=\"_blank\"\u003efaillissement\u003c/a\u003e benoemt de rechtbank een curator. Die neemt het beheer van je bedrijf en de beschikking over het vermogen over. Bij een WHOA-traject blijf jij in beginsel zelf bevoegd. Of de WHOA in jouw situatie beter is dan faillissement, ligt aan de financi\u0026#235;le positie en de vooruitzichten van je bedrijf.\u003c/p\u003e\n\n\u003ch2\u003eHulp en advies bij schulden\u003c/h2\u003e\n\n\u003cp\u003eHeb je problematische schulden? Wacht niet te lang. Hoe eerder je inzicht hebt in je financi\u0026#235;le situatie, hoe meer mogelijkheden er meestal zijn. De WHOA is een van de \u003ca class=\"anchor-target\" href=\"/zwaar-weer/schulden-oplossen-als-ondernemer-dit-zijn-je-opties/\" data-type=\"internal\"\u003everschillende schuldenregelingen\u003c/a\u003e. Heb je vragen of wil je over jouw situatie praten? Bel met het KVK Adviesteam.\u003c/p\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","content":{"contentType":"hippostd:html","value":"\u003cp\u003eElke situatie is anders. Daarom denken onze ondernemersadviseurs graag met je mee.\u003c/p\u003e\n\n\u003cul class=\"richtext-checkmark\"\u003e\n \u003cli\u003eOns advies is altijd gratis.\u003c/li\u003e\n \u003cli\u003eWij zijn elke werkdag bereikbaar van 8.30 uur tot 17.00 uur.\u003c/li\u003e\n \u003cli\u003eOnze adviseurs kennen de praktijk en geven persoonlijk advies.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003ca href=\"https://www.kvk.nl/hulp-en-contact/kvk-adviesteam/\"\u003eBel het KVK Adviesteam\u003c/a\u003e\u003c/p\u003e\n\n\u003cul\u003e\n\u003c/ul\u003e"},"title":"Sparren over jouw persoonlijke situatie?","contentType":"kvkwebsite:kader"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"Kun je de schulden van je bedrijf nu of binnenkort niet meer betalen? En dreigt een faillissement? Dan kan de Wet Homologatie Onderhands Akkoord (WHOA) een oplossing voor jou zijn. Met de WHOA kun je schulden oplossen via een akkoord met je schuldeisers. De rechter kan dit akkoord goedkeuren. Ook de schuldeisers die tegen hebben gestemd, moeten zich aan het akkoord houden. De WHOA is onderdeel van de Faillissementswet (Fw). Lees hoe de WHOA werkt.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Met de Wet Homologatie Onderhands Akkoord (WHOA) kun je faillissement voorkomen. Lees hoe het werkt.","title":"Op de rand van faillissement? De WHOA biedt uitkomst","image":null,"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"featuredCards":{"name":"kvkwebsite:featuredCards","displayName":"kvkwebsite:featuredCards","featuredCards":[{"uuid":"775db202-2ebf-4a98-bfdd-77c4ef36900e"},{"$ref":"#u58005976f9cd4cf4b3f542420b9fdf46"},{"$ref":"#u80f4c3454b9742eea50b1193d396532e"}],"cards":[{"uuid":"775db202-2ebf-4a98-bfdd-77c4ef36900e"},{"$ref":"#u58005976f9cd4cf4b3f542420b9fdf46"},{"$ref":"#u80f4c3454b9742eea50b1193d396532e"}],"title":"Anderen lezen ook","contentType":"kvkwebsite:featuredCards"},"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":3,"editorialPublicationDateWithDefault":1775829617218,"editorialModificationDate":1775824080000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1775824080000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Zwaar weer","key":"4","contentType":"selection:listitem","id":"a3d9a0fa-044c-442a-8101-29b379a94ef0"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Wetten en regels","key":"7","contentType":"selection:listitem","id":"b5e427ce-fd44-4907-9c48-19c36a4dd9d8"}],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Schulden","key":"45","contentType":"selection:listitem","id":"08568092-e45b-4f02-b93d-aa410c861200"}],"sector":[],"audience":[{"name":"selection:listitem","displayName":"selection:listitem","label":"ZZP","key":"1","contentType":"selection:listitem","id":"b03acec6-5662-43ab-a10d-e2e22c7f0da5"},{"name":"selection:listitem","displayName":"selection:listitem","label":"Micro-MKB","key":"2","contentType":"selection:listitem","id":"92f7f673-f3fd-4021-b827-bb7cb926679d"},{"name":"selection:listitem","displayName":"selection:listitem","label":"MKB","key":"3","contentType":"selection:listitem","id":"296c1685-798e-4ab5-9cf7-893d38cf092e"}],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","label":"De basis","key":"3","contentType":"selection:listitem","id":"36b33655-ebee-4dc1-b216-6c80c22f907e"},"author":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Gé Sletterink","key":"ge-sletterink","contentType":"selection:listitem","id":"da0b4071-b4c4-4453-a713-ca5b452b8e29"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Thunderbirds","key":"thunderbirds","contentType":"selection:listitem","id":"d528e480-7dad-4837-a4a6-ab704062d7d7"}],"lawOpenGovernment":[null]},"title":"Op de rand van faillissement? De WHOA biedt uitkomst","image":{"$ref":"#u0542fbe0a815449eb721e360f3a36494"},"localeString":"nl","contentType":"kvkwebsite:inspirationDocument","systemCreationDate":1677768646496,"systemModificationDate":1775829611532,"systemPublicationDate":1775829617218,"id":"1be521a6-3e6d-4823-bbb9-cefcd78b9f42"}},"u58005976f9cd4cf4b3f542420b9fdf46":{"type":"document","links":{"site":{"href":"/zwaar-weer/het-minnelijk-traject-voor-ondernemers-met-schulden/","type":"internal"}},"meta":{},"data":{"name":"het-minnelijk-traject-voor-ondernemers-met-schulden","displayName":"Het minnelijk traject, voor ondernemers met schulden","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Het minnelijk traject, voor ondernemers met schulden","seodescription":"Kun je je schulden niet meer betalen als ondernemer? Maak dan gebruik van een schuldenregeling, zoals het minnelijk traject (Msnp).","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003cp\u003eHet minnelijk traject uitgelegd:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003e\u003ca href=\"#wat\"\u003eWat is het minnelijk traject?\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"#wie\" class=\"internal-link\"\u003eVoor wie is het minnelijk traject?\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"#hoelang\"\u003eHoe lang duurt het minnelijk traject?\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"#werking\" class=\"internal-link\"\u003eHoe werkt het minnelijk traject?\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"#wsnp\" class=\"internal-link\"\u003eWat als het minnelijk traject mislukt?\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"#hulp\" class=\"internal-link\"\u003eHulp bij schulden oplossen\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch2\u003e\u003ca name=\"wat\" id=\"wat\" class=\"anchor-target\"\u003eWat is het minnelijk traject?\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eHet minnelijk traject is een vrijwillige schuldenregeling. Je onderzoekt eerst of je zelf je problemen kunt oplossen. Daarna maak je afspraken met je \u003cabbr tooltip=\"Iemand die nog geld moet krijgen\" title=\"Iemand die nog geld moet krijgen\"\u003eschuldeisers\u003c/abbr\u003e om je schulden binnen 18 maanden zoveel mogelijk af te lossen. Dat doe je zonder bemoeienis van de rechter. Je woongemeente of een gespecialiseerde schuldhulporganisatie helpt je hierbij.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"wie\" id=\"wie\" class=\"anchor-target\"\u003eVoor wie is het minnelijk traject?\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eHet minnelijk traject heet officieel \u0026#8216;minnelijke schuldenregeling natuurlijke personen\u0026#8217; (Msnp). De regeling is bedoeld voor natuurlijke personen (mensen). Dat zijn deze ondernemers:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eeigenaren van een eenmanszaak\u003c/li\u003e\n \u003cli\u003evennoten van een vof, maten in een maatschap en beherend vennoten van een commanditaire vennootschap (cv)\u003c/li\u003e\n \u003cli\u003edirecteur grootaandeelhouders (dga\u0026#8217;s) die priv\u0026#233; in de problemen zitten door hun bedrijf\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eDe Msnp is niet voor schulden van rechtspersonen, zoals een besloten vennootschap (bv), naamloze vennootschap (nv), vereniging of stichting. Voor een rechtspersoon met schulden kun je wel proberen onderlinge afspraken te maken met schuldeisers, de \u003ca class=\"anchor-target\" href=\"/zwaar-weer/op-de-rand-van-faillissement-de-whoa-biedt-uitkomst/\" data-type=\"internal\"\u003eWHOA\u003c/a\u003e gebruiken of surseance van betaling aanvragen.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"hoelang\" id=\"hoelang\" class=\"anchor-target\"\u003eHoe lang duurt het minnelijk traject?\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eHet traject duurt 18 maanden. Houd je je in die periode aan alle regels? Dan hoef je meestal de rest van je schuld niet meer terug te betalen. Daarover maak je afspraken aan het begin van het traject.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"werking\" id=\"werking\" class=\"anchor-target\"\u003eHoe werkt het minnelijk traject?\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eSoms kun je met hulp van een boekhouder of ondernemerscoach uit de financi\u0026#235;le problemen komen. Als dit niet lukt, heb je speciale hulp nodig. Je meldt je bij de gemeente of een schuldhulpbureau. De gemeente moet volgens de \u003ca rel=\"noopener noreferrer\" href=\"https://wetten.overheid.nl/BWBR0031331/2026-01-01\" class=\"external-link\" target=\"_blank\"\u003eWet gemeentelijke schuldhulpverlening (Wgs)\u003c/a\u003e schuldhulp verlenen aan particulieren en ondernemers met problematische schulden. Problematisch is het als je je zakelijke- \u0026#233;n priv\u0026#233;rekeningen niet meer kunt betalen. En als schuldeisers dreigen met beslaglegging op je huis of goederen of met het aanvragen van je faillissement. Kies je voor een commerci\u0026#235;le schuldhulpverlener? Dan moet je de kosten daarvan zelf betalen. Als je naar de gemeente gaat, betaalt die meestal de kosten voor jou.\u003c/p\u003e\n\n\u003ch3\u003eIntakegesprek en actieplan\u003c/h3\u003e\n\n\u003cp\u003eNa je aanmelding bij de gemeente of schuldhulpverlener volgt een intakegesprek. De gemeente schakelt hiervoor meestal een gespecialiseerde organisatie in. Tijdens dit gesprek geef je aan hoe hoog je schulden zijn, wie de schuldeisers zijn en zoek je samen uit welke aanpak het beste bij je situatie past. Blijkt uit het schuldenoverzicht dat je bedrijf niet levensvatbaar is? Dan is het beter om met je bedrijf te stoppen.\u003c/p\u003e\n\n\u003cp\u003eSamen met de gemeente of het schuldhulpbureau maak je een actieplan. Het duurt vaak een half jaar tot een jaar voordat alle afspraken met schuldeisers rond zijn en je met aflossing of betaling aan schuldeisers start. Je situatie bepaalt welk soort hulp voor jou mogelijk is.\u003c/p\u003e\n\n\u003ch3\u003eMinnelijk akkoord\u003c/h3\u003e\n\n\u003cp\u003eDe schuldhulpverlener onderzoekt welk deel van je schulden je terug kunt betalen. De hulpverlener maakt hierover afspraken met jou en de schuldeisers. Meestal wordt een periode van 18 maanden afgesproken. In die periode gaat een deel van je inkomen naar je schuldeisers. Zelf krijg je elke week een bedrag om je vaste lasten te betalen en om van te leven.\u003c/p\u003e\n\n\u003cp\u003eDe schuldhulpverlener stelt aan de schuldeisers voor om na die 18 maanden het restant van de schulden kwijt te schelden. Dat resterende deel hoef je niet terug te betalen. Als alle schuldeisers akkoord gaan met de afspraken, is er een minnelijk akkoord en kun je beginnen met aflossen.\u0026#160;Als je blijft ondernemen komt het geld voor de aflossingen uit de opbrengsten van je bedrijf. Stop je met je bedrijf? Dan moet je op een andere manier inkomen krijgen, bijvoorbeeld werken in loondienst.\u003c/p\u003e\n\n\u003ch3\u003eSaneringskrediet\u003c/h3\u003e\n\n\u003cp\u003eBlijkt uit het schuldenoverzicht dat je bedrijf levensvatbaar is en er genoeg inkomsten te verwachten zijn? Dan kun je misschien van de gemeente een saneringskrediet krijgen. Je leent dan geld van de gemeente. De hoogte van de lening is gebaseerd op het bedrag dat je in de afgesproken periode met rente terug kunt betalen. Met het bedrag van de lening wordt een voorstel aan alle schuldeisers gedaan om de vorderingen af te kopen en het restant kwijt te schelden. Als dat lukt kun je verder met ondernemen en je schuld aflossen bij de gemeente.\u003c/p\u003e\n\n\u003ch3\u003eDwangakkoord met schuldeisers\u003c/h3\u003e\n\n\u003cp\u003eDe kans bestaat dat \u0026#233;\u0026#233;n of meer schuldeisers niet mee willen werken aan het voorstel van de schuldhulpverlener. Ze zijn niet verplicht om mee te werken. Misschien willen ze geen afspraken met jou maken of vinden ze het bedrag dat ze terug gaan krijgen te laag.\u003c/p\u003e\n\n\u003cp\u003eJe kunt dan bij de rechter een verzoek indienen om weigerachtige schuldeisers te dwingen om mee te doen. Dat heet een dwangakkoord. De rechter beoordeelt of de weigerende schuldeisers goede redenen hebben om het voorstel af te slaan. Zijn er geen goede redenen, dan dwingt de rechter de schuldeisers om mee te werken en kan het traject van start. Je kunt alleen om een dwangakkoord vragen als het grootste deel van de schuldeisers w\u0026#233;l akkoord is gegaan.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"wsnp\" id=\"wsnp\" class=\"anchor-target\"\u003eWat als het minnelijk traject niet lukt?\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eLukt een minnelijk akkoord niet en legt de rechter ook geen dwangakkoord op? Dan kun je vragen of de rechter je wil toelaten tot het wettelijk schuldsaneringstraject: \u003ca class=\"anchor-target\" href=\"/zwaar-weer/schuldsanering-vaak-moet-je-stoppen-met-je-bedrijf/\" data-type=\"internal\"\u003eWet schuldsanering natuurlijke personen (Wsnp)\u003c/a\u003e. Dit kan ook met een verklaring van deskundigen of de gemeente waarin staat dat het vooraf al duidelijk is dat een minnelijk traject niet kansrijk is. Omdat er bijvoorbeeld helemaal geen kans is om schuldeisers over de streep te trekken. Meestal moet je stoppen met je onderneming als je tot de Wsnp wordt toegelaten.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"hulp\" id=\"hulp\" class=\"anchor-target\"\u003eHulp bij schulden oplossen\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eZoek je manieren om je schulden op te lossen? Gebruik het \u003ca class=\"anchor-target\" href=\"/zwaar-weer/stappenplan-schulden/\" data-type=\"internal\"\u003eStappenplan schulden oplossen\u003c/a\u003e. Of stel je vragen aan het KVK Adviesteam.\u003c/p\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","content":{"contentType":"hippostd:html","value":"\u003cp\u003eElke situatie is anders. Daarom denken onze ondernemersadviseurs graag met je mee.\u003c/p\u003e\n\n\u003cul class=\"richtext-checkmark\"\u003e\n \u003cli\u003eOns advies is altijd gratis.\u003c/li\u003e\n \u003cli\u003eWij zijn elke werkdag bereikbaar van 8.30 uur tot 17.00 uur.\u003c/li\u003e\n \u003cli\u003eOnze adviseurs kennen de praktijk en geven persoonlijk advies.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003ca href=\"https://www.kvk.nl/hulp-en-contact/kvk-adviesteam/\"\u003eBel het KVK Adviesteam\u003c/a\u003e\u003c/p\u003e\n\n\u003cul\u003e\n\u003c/ul\u003e"},"title":"Sparren over jouw persoonlijke situatie?","contentType":"kvkwebsite:kader"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"Kun je als ondernemer je schulden niet meer betalen? Met een schuldenregeling kun je de schulden oplossen. Bijvoorbeeld met de Minnelijke schuldenregeling natuurlijke personen (Msnp). Dat is een vrijwillige betalingsregeling en heet ook wel het minnelijk traject. Lees hoe het minnelijk traject werkt.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Kun je je schulden niet meer betalen als ondernemer? Maak dan gebruik van een schuldenregeling. Een minnelijk traject is zo’n regeling.","title":"Het minnelijk traject, voor ondernemers met schulden","image":null,"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"featuredCards":{"name":"kvkwebsite:featuredCards","displayName":"kvkwebsite:featuredCards","featuredCards":[{"uuid":"22a2cb78-b273-47db-b349-91fd751dfcc0"},{"uuid":"c0efe4c6-5829-4dc8-bfb1-4d613de95ba7"},{"$ref":"#u76ba5b56bd0144db86287dbd91ed1d6d"}],"cards":[{"uuid":"22a2cb78-b273-47db-b349-91fd751dfcc0"},{"uuid":"c0efe4c6-5829-4dc8-bfb1-4d613de95ba7"},{"$ref":"#u76ba5b56bd0144db86287dbd91ed1d6d"}],"title":"Anderen lezen ook","contentType":"kvkwebsite:featuredCards"},"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":4,"editorialPublicationDateWithDefault":1781264246352,"editorialModificationDate":1775823840000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1775823840000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Zwaar weer","key":"4","contentType":"selection:listitem","id":"a3d9a0fa-044c-442a-8101-29b379a94ef0"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Wetten en regels","key":"7","contentType":"selection:listitem","id":"b5e427ce-fd44-4907-9c48-19c36a4dd9d8"}],"transaction":[],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Schulden","key":"45","contentType":"selection:listitem","id":"08568092-e45b-4f02-b93d-aa410c861200"}],"sector":[],"audience":[{"name":"selection:listitem","displayName":"selection:listitem","label":"ZZP","key":"1","contentType":"selection:listitem","id":"b03acec6-5662-43ab-a10d-e2e22c7f0da5"},{"name":"selection:listitem","displayName":"selection:listitem","label":"MKB","key":"3","contentType":"selection:listitem","id":"296c1685-798e-4ab5-9cf7-893d38cf092e"},{"name":"selection:listitem","displayName":"selection:listitem","label":"Grootzakelijk","key":"4","contentType":"selection:listitem","id":"58ae52c6-6478-446a-b416-63fd45bd316a"}],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","label":"Achtergrond","key":"1","contentType":"selection:listitem","id":"59d14c68-fbb8-4a64-9be0-7633b09fc7f5"},"author":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Gé Sletterink","key":"ge-sletterink","contentType":"selection:listitem","id":"da0b4071-b4c4-4453-a713-ca5b452b8e29"}],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Thunderbirds","key":"thunderbirds","contentType":"selection:listitem","id":"d528e480-7dad-4837-a4a6-ab704062d7d7"}],"lawOpenGovernment":[null]},"title":"Het minnelijk traject, voor ondernemers met schulden","image":{"$ref":"#uf6de20f59d554d1e934d222cb922cc2c"},"localeString":"nl","contentType":"kvkwebsite:inspirationDocument","systemCreationDate":1677772180121,"systemModificationDate":1781264116200,"systemPublicationDate":1781264246352,"id":"58005976-f9cd-4cf4-b3f5-42420b9fdf46"}},"u0c08c6eeeee9422f9ab4108e33ba0b6e":{"type":"imageset","links":{},"meta":{},"data":{"name":"beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","displayName":"beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","regular":{"name":"kvkwebsite:regular","displayName":"kvkwebsite:regular","width":800,"height":600,"lastModified":1683734445926,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":25999,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/regular/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"wide":{"name":"kvkwebsite:wide","displayName":"kvkwebsite:wide","width":1200,"height":676,"lastModified":1683734446838,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":36331,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/wide/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"extraWide":{"name":"kvkwebsite:extraWide","displayName":"kvkwebsite:extraWide","width":1440,"height":617,"lastModified":1764691051044,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":37059,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/extraWide/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"flexHeight":{"name":"kvkwebsite:flexHeight","displayName":"kvkwebsite:flexHeight","width":1440,"height":810,"lastModified":1764678103188,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":47769,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/flexHeight/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"photo":{"name":"kvkwebsite:photo","displayName":"kvkwebsite:photo","width":800,"height":533,"lastModified":1764678103521,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":23257,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/photo/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"openGraph":{"name":"kvkwebsite:openGraph","displayName":"kvkwebsite:openGraph","width":1200,"height":630,"lastModified":1683734447016,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":34585,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/openGraph/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"fileName":"beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","description":"","thumbnail":{"name":"hippogallery:thumbnail","displayName":"hippogallery:thumbnail","width":60,"height":33,"lastModified":1675779834208,"mimeType":"image/jpeg","filename":"beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","contentType":"hippogallery:image","size":3087,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/thumbnail/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"original":{"name":"hippogallery:original","displayName":"hippogallery:original","width":1920,"height":1080,"lastModified":1675779834208,"mimeType":"image/jpeg","filename":null,"contentType":"hippogallery:image","size":221512,"links":{"site":{"href":"https://production-site-nl.kvk.bloomreach.cloud/binaries/content/gallery/kvkwebsite-nl/paginas/wetten-en-regels/beeld-wetten-en-regels-stroomschema-schulden-verken-je-opties.jpg","type":"resource"}}},"contentType":"kvkwebsite:imageSet","localeString":null,"id":"0c08c6ee-eee9-422f-9ab4-108e33ba0b6e"}},"u24358cc4dca14b678f45d01797c9f004":{"type":"document","links":{"site":{"href":"/veilig-zakendoen/herken-en-voorkom-faillissementsfraude/","type":"internal"}},"meta":{},"data":{"name":"herken-en-voorkom-faillissementsfraude","displayName":"Herken en voorkom faillissementsfraude","seo":{"name":"kvkwebsite:seo","displayName":"kvkwebsite:seo","seotitle":"Herken en voorkom faillissementsfraude bij zakenrelaties","seodescription":"Een faillissement van een klant of leverancier kan je bedrijf beschadigen. Kijk uit faillissementsfraude.","seonoindex":false,"contentType":"seosupport:seo"},"contentBlocks":[{"contentType":"hippostd:html","value":"\u003cul\u003e\n \u003cli\u003e\u003ca href=\"#0\" class=\"internal-link\"\u003eWat is faillissementsfraude?\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"#1\" class=\"internal-link\"\u003eZo herken je faillissementsfraude\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"#2\" class=\"internal-link\"\u003eVoorbeelden van faillissementsfraude\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"/veilig-zakendoen/herken-en-voorkom-faillissementsfraude#3\"\u003eDit kun je doen bij faillissementsfraude\u003c/a\u003e\u003c/li\u003e\n \u003cli\u003e\u003ca href=\"/veilig-zakendoen/herken-en-voorkom-faillissementsfraude#4\"\u003eControleer het Handelsregister\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch2\u003e\u003ca name=\"0\" id=\"0\" class=\"anchor-target\"\u003eWat is faillissementsfraude?\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eBij faillissementsfraude laat een ondernemer het bedrijf failliet gaan. Bijvoorbeeld nadat die expres (hoge) schulden heeft gemaakt. Wat ook voorkomt, is dat ondernemers bij een faillissement bepaalde bezittingen of geld met opzet geheimhouden voor de schuldeisers om zo de schulden niet te hoeven betalen. Faillissementsfraude is strafbaar.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"1\" id=\"1\" class=\"anchor-target\"\u003eZo herken je faillissementsfraude\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eFaillissementsfraude herkennen is lastig. Wel kun je letten op\u003ca class=\"anchor-target\" href=\"/zwaar-weer/snel-aan-de-slag-met-vroeg-signaleren-van-schuld/\" data-type=\"internal\"\u003e signalen die wijzen op geldproblemen \u003c/a\u003een een aankomend faillissement. Voorbeelden van zulke signalen zijn:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eHoog personeelsverloop: het bedrijf waarmee je zakendoet neemt steeds nieuwe medewerkers aan, maar die gaan ook snel weer weg.\u003c/li\u003e\n \u003cli\u003eOnregelmatige bestellingen: je zakenrelatie koopt opeens meer of juist minder in.\u003c/li\u003e\n \u003cli\u003eOnregelmatige betalingen: het bedrijf waarmee je zakendoet wil betalingen uitstellen.\u003c/li\u003e\n \u003cli\u003eVluchtgedrag: je kunt je zakenrelatie niet meer bereiken.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eVoorkom problemen en kom zo snel mogelijk in actie als het bedrijf waarmee je zakendoet je \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.kvk.nl/stappenplan-klant-betaalt-factuur-niet/\" class=\"external-link\" target=\"_blank\"\u003efactuur niet betaalt\u003c/a\u003e.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"2\" id=\"2\" class=\"anchor-target\"\u003eVoorbeelden van faillissementsfraude\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eHoe werkt faillissementsfraude? Er zijn verschillende vormen:\u003c/p\u003e\n\n\u003ch3\u003eBewust bevoordelen\u003c/h3\u003e\n\n\u003cp\u003eSoms betaalt een ondernemer vlak voor het faillissement nog even snel een deel van de zakenrelaties die nog geld moeten krijgen. Dit heet \u0026#8216;bewust bevoordelen van crediteuren\u0026#8217;. Andere zakenrelaties krijgen namelijk niets.\u003c/p\u003e\n\n\u003ch3\u003eOnttrekkingen\u003c/h3\u003e\n\n\u003cp\u003eBij een \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.kvk.nl/faillissement-en-hoe-u-dit-voorkomt/\" class=\"external-link\" target=\"_blank\"\u003efaillissement \u003c/a\u003ebeheert een \u003ca rel=\"noopener noreferrer\" href=\"https://ondernemersplein.kvk.nl/de-rol-van-een-curator-bij-een-faillissement/\" class=\"external-link\" target=\"_blank\"\u003ecurator\u003c/a\u003e het vermogen en de bezittingen van het bedrijf. Een curator is een door de rechter aangewezen advocaat die de zaak van de failliete ondernemer behandelt. De naam van de curator vind je in het \u003ca rel=\"noopener noreferrer\" href=\"https://insolventies.rechtspraak.nl/#!/zoeken/index\" class=\"external-link\" target=\"_blank\"\u003eCentraal Insolventieregister\u003c/a\u003e. De curator maakt afspraken met de degenen die nog geld krijgen. Als een ondernemer geld of bezittingen voor de curator verstopt, is dat fraude. Dit noem je \u0026#8216;onttrekking\u0026#8217;. Denk hierbij aan:\u003c/p\u003e\n\n\u003cul\u003e\n \u003cli\u003eGeld laten verdwijnen door grote contante priv\u0026#233;opnames te doen.\u003c/li\u003e\n \u003cli\u003eWaardevolle bezittingen weghalen, zoals auto\u0026#8217;s, machines en andere bedrijfsspullen.\u003c/li\u003e\n \u003cli\u003eKlanten rekeningen laten betalen op nieuwe bankrekeningen die de curator niet kent.\u003c/li\u003e\n \u003cli\u003eHet klantenbestand verkopen aan of meenemen naar een nieuw opgericht bedrijf\u0026#160;waarvan de fraudeur eigenaar is.\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003ch3\u003eKopen zonder betalen\u003c/h3\u003e\n\n\u003cp\u003eOneerlijke ondernemers kopen soms met opzet spullen die ze niet kunnen betalen. Ze betalen de verkoper niet en verkopen de goederen snel door. Tegen de tijd dat verkopers hun geld opeisen en faillissement van de oneerlijke ondernemer aanvragen, is die verdwenen.\u003c/p\u003e\n\n\u003ch3\u003eStiekem betalen voor de verkoop van een bedrijf\u003c/h3\u003e\n\n\u003cp\u003eOndernemers met hoge schulden verkopen hun bedrijf soms, zodat de koper het failliet kan laten gaan. De koper weet dat het bedrijf niet meer te redden valt en neemt het bedrijf officieel over voor een laag bedrag. De verkoper betaalt in het geheim voor het overnemen van het bedrijf. De nieuwe eigenaar vernietigt de boekhouding en laat alle bezittingen van waarde verdwijnen. Hierdoor krijgen zakenrelaties die nog geld tegoed hebben hun geld niet. Het niet kunnen laten zien of weggooien van de boekhouding is strafbaar.\u003c/p\u003e\n\n\u003ch3\u003eTurboliquidatie misbruiken\u003c/h3\u003e\n\n\u003cp\u003e\u003ca class=\"anchor-target\" href=\"/stoppen-en-uitschrijven/een-rechtspersoon-beeindigen-via-de-turboliquidatie/\" data-type=\"internal\"\u003eTurboliquidatie \u003c/a\u003eis een snelle manier om een bv, nv, stichting of andere rechtspersoon op te heffen. Dit kan alleen als de rechtspersoon geen bezittingen heeft. Hier wordt soms misbruik van gemaakt. De bestuurder laat bezittingen verdwijnen en alleen de schulden blijven in het bedrijf achter. Degenen die nog geld tegoed hebben zijn hiervan het slachtoffer, want zij krijgen hun geld niet.\u003c/p\u003e\n\n\u003ch3\u003eKatvanger gebruiken\u003c/h3\u003e\n\n\u003cp\u003eBij een faillissement zijn bestuurders met hun zakelijke vermogen en soms ook met priv\u0026#233;vermogen aansprakelijk voor de schulden van het bedrijf. Om geen geld kwijt te raken, stellen frauderende ondernemers kort voor het faillissement een \u0026#8216;katvanger\u0026#8217; aan. Dit is iemand zonder geld en bezittingen, die zich als bestuurder, eigenaar of aandeelhouder van de onderneming in het KVK Handelsregister inschrijft.\u003c/p\u003e\n\n\u003cp\u003eDe katvanger neemt het bedrijf inclusief de schulden en bezittingen over. Vervolgens sluist die de bezittingen uit het bedrijf door naar de oorspronkelijke eigenaar. De schulden blijven onbetaald. Bij een faillietverklaring valt er niets te halen bij deze katvanger. Het zakelijk en priv\u0026#233;vermogen van de oorspronkelijke eigenaar blijven veilig. Katvangers worden vaak van de straat geplukt en zijn lastig terug te vinden, omdat zij bijvoorbeeld geen vast woonadres of werk hebben.\u003c/p\u003e"},{"name":"kvkwebsite:contentBlocks","displayName":"kvkwebsite:contentBlocks","text":"Het is niet altijd mogelijk om als schuldeiser al je geld terug te krijgen.","contentType":"kvkwebsite:quote"},{"contentType":"hippostd:html","value":"\u003ch2\u003e\u003ca name=\"3\" id=\"3\" class=\"anchor-target\"\u003eDit kun je doen bij faillissementsfraude\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eDenk je dat je bedrijf slachtoffer is van faillissementsfraude? Maak er melding van bij de \u003ca rel=\"noopener noreferrer\" href=\"https://www.fraudehelpdesk.nl/\" class=\"external-link\" target=\"_blank\"\u003eFraudehelpdesk \u003c/a\u003een neem contact op met de curator. De curator zal de faillissementsfraude melden bij het Centraal Meldpunt Faillissementsfraude.\u003c/p\u003e\n\n\u003cp\u003eDeel de informatie die je hebt over de failliete ondernemer, ook wel schuldenaar genoemd, met de curator. Die beoordeelt of de ondernemer verkeerd gehandeld heeft, dit noem je wanbeleid. Als dit zo is, kan de curator (een deel van) het faillissementstekort terugvragen aan de failliete ondernemer. Die moet dit dan bijvoorbeeld uit priv\u0026#233;vermogen betalen. Het faillissementstekort is het totale bedrag aan schulden en kosten van het faillissement, min de opbrengsten die na het faillissement zijn binnengekomen. Heeft de schuldenaar betalingen gedaan die nadelig zijn voor schuldeisers? Dan kan de curator die terugdraaien. Het is niet altijd mogelijk om als schuldeiser al je geld terug te krijgen. Soms krijg je een gedeelte terug en soms helemaal niets. Dit wordt pas duidelijk als de curator het faillissement heeft afgerond.\u003c/p\u003e\n\n\u003ch2\u003e\u003ca name=\"4\" id=\"4\" class=\"anchor-target\"\u003eControleer het Handelsregister\u003c/a\u003e\u003c/h2\u003e\n\n\u003cp\u003eJe kunt problemen voorkomen als je weet met wie je zakendoet. Misschien vermoed je dat een bedrijf failliet is of uitstel van betaling heeft aangevraagd bij de rechtbank. Controleer dit in het \u003ca class=\"anchor-target\" href=\"/veilig-zakendoen/is-je-zakenpartner-betrouwbaar-doe-deze-checks/\" data-type=\"internal\"\u003eHandelsregister\u003c/a\u003e. Alle Nederlandse bedrijven en organisaties staan daarin. Informatie over een buitenlandse zakenrelatie zoek je op via een \u003ca class=\"anchor-target\" href=\"/over-het-handelsregister/buitenlandse-registers/\" data-type=\"internal\"\u003ebuitenlands register\u003c/a\u003e.\u003c/p\u003e\n\n\u003cp\u003eBedenk dat zakenrelaties ook informatie over jouw bedrijf opzoeken in het Handelsregister om te kijken of je betrouwbaar bent. Je bedrijf ontwikkelt zich en je situatie kan veranderen. \u003ca class=\"anchor-target\" href=\"/veilig-zakendoen/check-regelmatig-je-registratie-bij-kvk/\" data-type=\"internal\"\u003eCheck daarom regelmatig of je inschrijving nog klopt\u003c/a\u003e.\u003c/p\u003e"}],"teamEnglish":{"name":"kvkwebsite:teamEnglish","displayName":"kvkwebsite:teamEnglish","actionTeamEnglish":"5","changesTeamEnglish":false,"contentType":"kvkwebsite:teamEnglish"},"chatbotSettings":{"name":"kvkwebsite:chatbotSettings","displayName":"kvkwebsite:chatbotSettings","showProactiveChatbot":false,"contentType":"kvkwebsite:chatbotSettings"},"intro":"In 2025 gingen 3.636 bedrijven in Nederland failliet. Door geldproblemen konden zij hun rekeningen niet meer betalen. Van deze bedrijven gaat ongeveer een kwart expres failliet om zakenrelaties te misleiden. Ontdek hoe je faillissementsfraude herkent bij een bedrijf waar je zaken mee doet.","teaser":{"name":"kvkwebsite:teaser","displayName":"kvkwebsite:teaser","description":"Een faillissement van een klant of leverancier kan je bedrijf beschadigen. Kijk uit faillissementsfraude.","title":"Herken en voorkom faillissementsfraude bij zakenrelaties","image":null,"contentType":"kvkwebsite:teaser"},"pageNotifications":{"name":"kvkwebsite:pageNotifications","displayName":"kvkwebsite:pageNotifications","pageNotifications":[],"contentType":"kvkwebsite:pageNotificationContainer"},"featuredCards":{"name":"kvkwebsite:featuredCards","displayName":"kvkwebsite:featuredCards","featuredCards":[{"uuid":"95df71a7-df5b-4a3d-bb5f-5cf3d2672ad4"},{"uuid":"7935d624-3026-4ba7-bb2b-f89c7bdc5012"},{"uuid":"cd1dce1d-ee99-4671-ac95-56376be73509"}],"cards":[{"uuid":"95df71a7-df5b-4a3d-bb5f-5cf3d2672ad4"},{"uuid":"7935d624-3026-4ba7-bb2b-f89c7bdc5012"},{"uuid":"cd1dce1d-ee99-4671-ac95-56376be73509"}],"title":"Anderen lezen ook","contentType":"kvkwebsite:featuredCards"},"metadata":{"name":"kvkwebsite:metadata","displayName":"kvkwebsite:metadata","sdgCompliant":false,"readingTime":3,"editorialPublicationDateWithDefault":1775207055482,"editorialModificationDate":1775143620000,"overviewPageLinkLabel":"","overviewPageLink":"","editorialModificationDateLabel":"Bijgewerkt","sdgcompliant":false,"contentType":"kvkwebsite:metadata","editorialPublicationDate":null,"mostRecentChangeDate":1775143620000,"phase":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Runnen en groeien","key":"2","contentType":"selection:listitem","id":"fc3e09d7-df31-4749-a4d2-2689d8fc01e2"}],"theme":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Veilig zakendoen","key":"6","contentType":"selection:listitem","id":"705bdfb4-2227-413b-b909-1e83dada2ff8"}],"transaction":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Producten bestellen","key":"5","contentType":"selection:listitem","id":"a486361d-5da4-49ce-a62a-94dc9d969627"}],"organization":[],"subject":[{"name":"selection:listitem","displayName":"selection:listitem","label":"Bedrijfsrisico's","key":"5","contentType":"selection:listitem","id":"24f53b90-cb7b-4ddb-baba-b481d961f6b4"},{"name":"selection:listitem","displayName":"selection:listitem","label":"Fraude","key":"22","contentType":"selection:listitem","id":"675b20fa-d7ee-481a-b833-f926e93e8a7c"}],"sector":[],"audience":[],"articleType":{"name":"selection:listitem","displayName":"selection:listitem","label":"Achtergrond","key":"1","contentType":"selection:listitem","id":"59d14c68-fbb8-4a64-9be0-7633b09fc7f5"},"author":[],"contentTeam":[{"name":"selection:listitem","displayName":"selection:listitem","label":"WRR","key":"wrr","contentType":"selection:listitem","id":"d7a9554f-5ea2-4134-9a38-7de44340b812"}],"lawOpenGovernment":[null]},"title":"Herken en voorkom faillissementsfraude bij zakenrelaties","image":{"$ref":"#u28c5e4e6ee854065b998cd22bbfa511e"},"localeString":"nl","contentType":"kvkwebsite:inspirationDocument","systemCreationDate":1677765545432,"systemModificationDate":1